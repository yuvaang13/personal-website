---
/**
 * GlassFolderDesk — the stage the folders live on.
 *
 * A dotted, softly lit desk that frames a row of GlassFolder components. Kept as
 * a separate component so the same tactile motif can be reused across the site
 * without duplicating the ambient lighting / responsive grid rules.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  id?: string;
  class?: string;
  caption?: string;
}

const {
  eyebrow = 'workspace/',
  title = 'A desk of ideas.',
  body = 'Every project is a folder you can open. Hover to lean the glass, click to fan the files.',
  id,
  class: className = '',
  caption = 'Hover to lean · Click to open · + to add',
} = Astro.props;
---

<section id={id} class={`folder-desk relative isolate overflow-hidden ${className}`} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="folder-desk__glow folder-desk__glow--one" aria-hidden="true"></div>
  <div class="folder-desk__glow folder-desk__glow--two" aria-hidden="true"></div>
  <div class="folder-desk__dots" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
    <div class="mx-auto mb-16 max-w-3xl text-center" data-scroll-reveal data-direction="up" data-distance="30">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={id ? `${id}-title` : undefined} class="heading-2 mt-5 text-balance">{title}</h2>
      <p class="body-md mx-auto mt-5 max-w-2xl">{body}</p>
    </div>

    <div
      class="folder-desk__tray mx-auto flex max-w-6xl flex-wrap items-end justify-center gap-x-12 gap-y-16 xl:gap-x-16"
      data-stagger-container
      data-stagger="0.12"
      data-delay-children="0.15"
    >
      <slot />
    </div>

    <p class="relative mt-16 text-center font-mono text-[10px] uppercase tracking-[0.24em] text-mistral-textMuted">
      {caption}
    </p>
  </div>
</section>

<style>
  .folder-desk {
    position: relative;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0) 60%),
      linear-gradient(180deg, #0d0d10 0%, #0a0a0c 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .folder-desk__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1.3px);
    background-size: 22px 22px;
    opacity: 0.28;
    mask-image: radial-gradient(ellipse 80% 75% at 50% 45%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 75% at 50% 45%, #000 20%, transparent 100%);
    pointer-events: none;
  }

  .folder-desk__glow {
    position: absolute;
    width: 42rem;
    height: 42rem;
    border-radius: 999px;
    filter: blur(110px);
    pointer-events: none;
    opacity: 0.16;
  }

  .folder-desk__glow--one {
    left: -14rem;
    top: -14rem;
    background: radial-gradient(circle, #b06a4a, transparent 68%);
  }

  .folder-desk__glow--two {
    right: -16rem;
    bottom: -18rem;
    background: radial-gradient(circle, #4d6aa8, transparent 68%);
  }

  .folder-desk__tray {
    perspective: 1600px;
  }

  @media (max-width: 640px) {
    .folder-desk__glow { width: 26rem; height: 26rem; }
  }
</style>
