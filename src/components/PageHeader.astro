---
// PageHeader.astro - Consistent section header component

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  class?: string;
  number?: string;
}

const { eyebrow, title, body, class: className = '', number } = Astro.props;
---

<section
  data-od-id="page-header"
  class={className}
  data-scroll-reveal
  data-direction="up"
  data-distance="24"
  data-delay="0"
>
  {number && (
    <div class="mb-6">
      <span class="font-mono text-[11px] uppercase tracking-widest text-mistral-textMuted">{number}</span>
      <span class="h-0.5 w-6 block mt-1.5 bg-mistral-text" aria-hidden="true" />
    </div>
  )}
  <div class="mx-auto max-w-7xl px-5 pb-12 pt-16 sm:px-8 lg:pb-16 lg:pt-24">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-4 max-w-5xl heading-1" data-parallax="0.05">{title}</h1>
    <p class="mt-6 max-w-3xl body-lg">{body}</p>
  </div>
</section>
