---
// PageHeader.astro - Consistent section header component

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  className?: string;
}

const { eyebrow, title, body, className = '' } = Astro.props;
---

<section
  data-od-id="page-header"
  class={className}
  data-scroll-reveal
  data-direction="up"
  data-distance="24"
  data-delay="0"
>
  <div class="mx-auto max-w-7xl px-5 pb-20 pt-36 sm:px-8 lg:pb-28 lg:pt-48">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-8 max-w-5xl heading-1">{title}</h1>
    <p class="mt-10 max-w-3xl body-lg">{body}</p>
  </div>
</section>
