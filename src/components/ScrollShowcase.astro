---
import { projects } from '@/data/profile';

const showcaseOrder = ['Infinit AI', 'Verus', 'MonkMode'];
const showcaseProjects = showcaseOrder
  .map((title) => projects.find((project) => project.title === title))
  .filter(Boolean);

// Explicit external links for scroll_lab clickable cards (user request)
const showcaseLinks: Record<string, string> = {
  'Verus': 'https://verus0.vercel.app/demo',
  'MonkMode': 'https://github.com/yuvaang13/MonkMode-An-Open-Sourced-iOS-Application-For-Maximizing-Productivity',
};

const getShowcaseHref = (title: string, fallback?: string) => showcaseLinks[title] ?? fallback;
---

<section class="scroll-showcase" data-scroll-showcase aria-label="Scroll-driven project showcase">
  <div class="scroll-showcase__sticky">
    <div class="scroll-showcase__frame">
      <div class="scroll-showcase__copy">
        <p class="eyebrow">scroll_lab/</p>
        <div class="scroll-showcase__stages">
          {showcaseProjects.map((project, index) => {
            const href = getShowcaseHref(project!.title, project!.links?.[0]?.href);
            const isLinked = Boolean(href);
            return (
              <article class:list={["scroll-showcase__stage", { "is-active": index === 0 }]} data-showcase-stage>
                <p class="scroll-showcase__index">0{index + 1} / 0{showcaseProjects.length}</p>
                {isLinked ? (
                  <h2><a href={href} target="_blank" rel="noreferrer" class="focus-ring scroll-showcase__title-link" aria-label={`Open ${project!.title}`}>{project!.title}</a></h2>
                ) : (
                  <h2>{project!.title}</h2>
                )}
                <p>{project!.summary}</p>
                <div class="scroll-showcase__tags" aria-label={`${project!.title} tags`}>
                  {project!.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
                </div>
              </article>
            );
          })}
        </div>
      </div>

      <div class="scroll-showcase__visual">
        {showcaseProjects.map((project, index) => {
            const href = getShowcaseHref(project!.title, project!.links?.[0]?.href);
            const isLinked = Boolean(href);
            return (
              <figure class:list={["scroll-showcase__project", { "is-active": index === 0 }]} data-showcase-visual>
                {project!.image && isLinked ? (
                  <a href={href} target="_blank" rel="noreferrer" class="focus-ring scroll-showcase__visual-link" aria-label={`Open ${project!.title}`}>
                    <img src={project!.image} alt={`${project!.title} preview`} loading={index === 0 ? 'eager' : 'lazy'} />
                  </a>
                ) : project!.image ? (
                  <img src={project!.image} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
                ) : null}
              </figure>
            );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  /* Enable clicks on active stage only; keep inactive stages non-interactive */
  .scroll-showcase__stage.is-active {
    pointer-events: auto;
  }
  .scroll-showcase__stage:not(.is-active) {
    pointer-events: none;
  }
  .scroll-showcase__title-link {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 200ms ease;
  }
  .scroll-showcase__title-link:hover {
    opacity: 0.72;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .scroll-showcase__visual-link {
    display: block;
    cursor: pointer;
    border-radius: 4px;
  }
  .scroll-showcase__visual-link img {
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), filter 300ms ease;
  }
  .scroll-showcase__visual-link:hover img {
    transform: scale(1.02);
    filter: brightness(1.02);
  }
  @media (max-width: 820px) {
    .scroll-showcase__stage {
      pointer-events: auto !important;
    }
  }
</style>

<script>
  const showcases = document.querySelectorAll<HTMLElement>('[data-scroll-showcase]');

  const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));

  showcases.forEach((showcase) => {
    const stages = Array.from(showcase.querySelectorAll<HTMLElement>('[data-showcase-stage]'));
    const visuals = Array.from(showcase.querySelectorAll<HTMLElement>('[data-showcase-visual]'));

    const update = () => {
      const rect = showcase.getBoundingClientRect();
      const travel = Math.max(1, rect.height - window.innerHeight);
      const progress = clamp(-rect.top / travel);
      const segment = stages.length > 1 ? 1 / stages.length : 1;
      const activeIndex = Math.min(stages.length - 1, Math.floor(progress / segment));

      showcase.style.setProperty('--showcase-progress', progress.toFixed(4));

      stages.forEach((stage, index) => {
        const distance = index - activeIndex;
        stage.classList.toggle('is-active', index === activeIndex);
        stage.style.setProperty('--stage-distance', String(distance));
      });

      visuals.forEach((visual, index) => {
        const distance = index - activeIndex;
        visual.classList.toggle('is-active', index === activeIndex);
        visual.style.setProperty('--visual-distance', String(distance));
      });
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  });
</script>
