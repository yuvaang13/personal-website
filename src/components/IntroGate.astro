---
// Scroll-driven split-shutter intro. The shutters open with the first scroll.

const rawPath = (Astro.url.pathname.replace(/\/$/, '') || '/');
const introMap: Record<string, { title: string; eyebrow: string }> = {
  '/': { title: 'Yuvaan Gulati.', eyebrow: '~/yuvaan_gulati --init portfolio' },
  '/about': { title: 'About Me.', eyebrow: '~/about_me --cat profile.md' },
  '/projects': { title: 'Projects.', eyebrow: '~/projects --ls -la' },
  '/experience': { title: 'Experience.', eyebrow: '~/experience --timeline' },
  '/contact': { title: 'Contact.', eyebrow: '~/contact --ping' },
};
const cfg = introMap[rawPath] ?? { title: 'Yuvaan Gulati.', eyebrow: `~${rawPath} --init` };
---

<div id="intro-gate" class="intro-gate" aria-hidden="true" role="presentation" data-eyebrow={cfg.eyebrow}>
  <script is:inline>
    (() => {
      try {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) {
          document.documentElement.classList.add('intro-skip');
        }
      } catch (_) {}
    })();
  </script>

  <div class="intro-shutter intro-shutter--top">
    <div class="intro-stage">
      <p class="intro-eyebrow">{cfg.eyebrow}</p>
      <h2 class="intro-name" aria-hidden="true">
        {cfg.title.split('').map((ch, i) => (
          <span class="intro-letter" style={`--letter-i: ${i}`}><span class="intro-letter__inner">{ch === ' ' ? '\u00A0' : ch}</span></span>
        ))}
      </h2>
      <div class="intro-rule"></div>
    </div>
  </div>
  <div class="intro-shutter intro-shutter--bottom">
    <div class="intro-stage">
      <p class="intro-eyebrow" aria-hidden="true">{cfg.eyebrow}</p>
      <h2 class="intro-name" aria-hidden="true">
        {cfg.title.split('').map((ch, i) => (
          <span class="intro-letter" style={`--letter-i: ${i}`}><span class="intro-letter__inner">{ch === ' ' ? '\u00A0' : ch}</span></span>
        ))}
      </h2>
      <div class="intro-rule" aria-hidden="true"></div>
    </div>
  </div>
</div>

<style>
  .intro-gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: transparent;
    pointer-events: none;
    --intro-progress: 0;
  }

  .intro-shutter {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    overflow: hidden;
    background: var(--color-bg);
    will-change: transform;
  }

  .intro-shutter--top {
    top: 0;
    border-bottom: 1px solid var(--color-border);
    transform: translateY(calc(var(--intro-progress) * -101%));
  }

  .intro-shutter--bottom {
    bottom: 0;
    border-top: 1px solid var(--color-border);
    transform: translateY(calc(var(--intro-progress) * 101%));
  }

  .intro-stage {
    position: absolute;
    left: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem;
    box-sizing: border-box;
    opacity: calc(1 - var(--intro-progress));
    transform: translateY(calc(var(--intro-progress) * -10px));
    will-change: opacity, transform;
  }

  .intro-shutter--top .intro-stage {
    top: 0;
  }

  .intro-shutter--bottom .intro-stage {
    bottom: 0;
    transform: translateY(calc(var(--intro-progress) * 10px));
  }

  .intro-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(0.65rem, 1.2vw, 0.85rem);
    letter-spacing: 0.22em;
    text-transform: lowercase;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    opacity: 1;
    transform: translateY(0);
  }

  .intro-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 7.5vw, 7.5rem);
    line-height: 1.0;
    letter-spacing: -0.02em;
    text-wrap: balance;
    text-align: center;
    margin: 0;
    opacity: 1;
  }

  .intro-letter {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    opacity: 1;
    transform: translateY(0);
  }

  .intro-letter__inner {
    display: block;
  }

  .intro-rule {
    width: 100%;
    max-width: 280px;
    height: 1px;
    background: var(--color-text-primary);
    opacity: 1;
  }

  html.intro-skip .intro-gate {
    display: none !important;
  }
</style>

<script>
  const gate = document.getElementById('intro-gate');
  if (!gate) {
    document.dispatchEvent(new CustomEvent('intro:done'));
  } else if (document.documentElement.classList.contains('intro-skip')) {
    gate.remove();
    document.dispatchEvent(new CustomEvent('intro:done'));
  } else {
    const threshold = () => Math.min(760, Math.max(480, window.innerHeight * 0.75));
    let done = false;
    let rafId = 0;

    const finish = () => {
      done = true;
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      document.dispatchEvent(new CustomEvent('intro:done'));
      requestAnimationFrame(() => gate.remove());
    };

    const update = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      const progress = Math.min(1, Math.max(0, scrollY / threshold()));
      gate.style.setProperty('--intro-progress', progress.toFixed(4));

      if (progress >= 0.995 && !done) {
        finish();
      }
    };

    const onScroll = () => {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = 0;
        update();
      });
    };

    // initial state — gate closed at top
    gate.style.setProperty('--intro-progress', '0');
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Lenis updates scroll position in its own animation frame.
    let lastY = -1;
    const poll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      if (y !== lastY) {
        lastY = y;
        update();
      }
      if (!done) requestAnimationFrame(poll);
    };
    requestAnimationFrame(poll);

    // The gate stays at rest until the visitor starts scrolling.
  }
</script>
