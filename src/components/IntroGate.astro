---
// IntroGate.astro - Cinematic intro for every route
// Split-shutter reveal: "Yuvaan Gulati" tears open into the page content
---

<div id="intro-gate" class="intro-gate" aria-hidden="true" role="presentation">
  <script is:inline>
    (() => {
      try {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const path = (location.pathname.replace(/\/$/, '') || '/');
        const key = 'yg_intro_v1:' + path;
        if (reduced || sessionStorage.getItem(key) === '1') {
          document.documentElement.classList.add('intro-skip');
        }
      } catch (_) {}
    })();
  </script>

  <div class="intro-shutter intro-shutter--top">
    <div class="intro-stage">
      <p class="intro-eyebrow"><span class="intro-eyebrow__text"></span><span class="intro-caret" aria-hidden="true"></span></p>
      <h2 class="intro-name" aria-hidden="true">
        {'Yuvaan Gulati.'.split('').map((ch, i) => (
          <span class="intro-letter" style={`--letter-i: ${i}`}><span class="intro-letter__inner">{ch === ' ' ? '\u00A0' : ch}</span></span>
        ))}
      </h2>
      <div class="intro-rule"></div>
      <p class="intro-hint">click or press any key to enter</p>
    </div>
  </div>
  <div class="intro-shutter intro-shutter--bottom">
    <div class="intro-stage">
      <p class="intro-eyebrow"><span class="intro-eyebrow__text"></span><span class="intro-caret" aria-hidden="true"></span></p>
      <h2 class="intro-name" aria-hidden="true">
        {'Yuvaan Gulati.'.split('').map((ch, i) => (
          <span class="intro-letter" style={`--letter-i: ${i}`}><span class="intro-letter__inner">{ch === ' ' ? '\u00A0' : ch}</span></span>
        ))}
      </h2>
      <div class="intro-rule"></div>
      <p class="intro-hint">click or press any key to enter</p>
    </div>
  </div>
</div>

<style>
  .intro-gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--color-bg);
    pointer-events: all;
  }

  .intro-shutter {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50.05%;
    overflow: hidden;
    background: var(--color-bg);
    transition: transform 950ms cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }

  .intro-shutter--top {
    top: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .intro-shutter--bottom {
    bottom: 0;
    border-top: 1px solid var(--color-border);
    transition-delay: 60ms;
  }

  .intro-gate.is-leaving .intro-shutter--top {
    transform: translateY(-101%);
  }

  .intro-gate.is-leaving .intro-shutter--bottom {
    transform: translateY(101%);
  }

  .intro-stage {
    position: absolute;
    left: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem;
    box-sizing: border-box;
  }

  .intro-shutter--top .intro-stage {
    top: 0;
  }

  .intro-shutter--bottom .intro-stage {
    bottom: 0;
  }

  .intro-gate.is-leaving .intro-stage {
    transition: opacity 400ms ease, filter 400ms ease, transform 950ms cubic-bezier(0.76, 0, 0.24, 1);
    opacity: 0.6;
    filter: blur(2px);
    transform: scale(1.04);
  }

  .intro-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(0.65rem, 1.2vw, 0.85rem);
    letter-spacing: 0.22em;
    text-transform: lowercase;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .intro-gate.ff .intro-eyebrow,
  .intro-gate.letters-in .intro-eyebrow {
    opacity: 1;
    transform: translateY(0);
  }

  .intro-eyebrow__text {
    display: inline-block;
    vertical-align: bottom;
  }

  .intro-caret {
    display: inline-block;
    width: 0.7ch;
    height: 1.1em;
    margin-left: 0.3ch;
    background: currentColor;
    vertical-align: bottom;
    animation: caret-blink 1s steps(2) infinite;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .intro-gate.is-typing .intro-caret {
    opacity: 1;
  }

  .intro-gate:not(.is-typing) .intro-caret {
    display: none;
  }

  @keyframes caret-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .intro-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 7.5vw, 7.5rem);
    line-height: 1.0;
    letter-spacing: -0.02em;
    text-wrap: balance;
    text-align: center;
    margin: 0;
    opacity: 0;
  }

  .intro-gate.letters-in .intro-name {
    opacity: 1;
  }

  .intro-letter {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    opacity: 0;
    transform: translateY(110%);
    transition: opacity 650ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--letter-i) * 55ms);
  }

  .intro-gate.letters-in .intro-letter {
    opacity: 1;
    transform: translateY(0);
  }

  .intro-gate.ff .intro-letter {
    transition-duration: 0ms !important;
    opacity: 1;
    transform: translateY(0);
  }

  .intro-letter__inner {
    display: block;
  }

  .intro-rule {
    width: 0;
    height: 1px;
    background: var(--color-text-primary);
    opacity: 0;
    transition: width 500ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease;
  }

  .intro-gate.rule-in .intro-rule {
    width: 100%;
    max-width: 420px;
    opacity: 1;
  }

  .intro-gate.ff .intro-rule {
    transition-duration: 0ms !important;
    width: 100%;
    max-width: 420px;
    opacity: 1;
  }

  .intro-hint {
    font-family: var(--font-mono);
    font-size: clamp(0.6rem, 1vw, 0.75rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 400ms ease 200ms, transform 400ms ease 200ms;
  }

  .intro-gate.hint-in .intro-hint {
    opacity: 0.7;
    transform: translateY(0);
  }

  .intro-gate.ff .intro-hint {
    transition-delay: 0ms !important;
    transition-duration: 0ms !important;
    opacity: 0.7;
    transform: translateY(0);
  }

  html.intro-skip .intro-gate {
    display: none !important;
  }

  html.intro-lock,
  html.intro-lock body {
    overflow: hidden !important;
    overscroll-behavior: none;
  }
</style>

<script>
  const gate = document.getElementById('intro-gate');
  if (!gate) {
    // No gate in DOM (shouldn't happen)
    document.dispatchEvent(new CustomEvent('intro:done'));
  } else if (document.documentElement.classList.contains('intro-skip')) {
    // Reduced motion or already played this session
    gate.remove();
    document.documentElement.classList.remove('intro-lock');
    document.dispatchEvent(new CustomEvent('intro:done'));
  } else {
    // Play the intro — per-route so each tab gets its own first-play
    document.documentElement.classList.add('intro-lock');
    try {
      const p = (location.pathname.replace(/\/$/, '') || '/');
      sessionStorage.setItem('yg_intro_v1:' + p, '1');
    } catch (_) {}

    const eyebrowText = gate.querySelectorAll('.intro-eyebrow__text');
    const fullEyebrow = '~/yuvaan_gulati --init portfolio';
    let charIndex = 0;
    let typingTimer = 0;
    let sequenceTimer = 0;
    let isFastForward = false;

    const phases = [
      { delay: 200, fn: () => { gate.classList.add('is-typing'); startTyping(); } },
      { delay: 400, fn: () => { gate.classList.add('letters-in'); } },
      { delay: 1650, fn: () => { gate.classList.add('rule-in'); } },
      { delay: 2300, fn: () => { gate.classList.add('hint-in'); } },
      { delay: 2600, fn: () => { /* wait for user interaction or auto-leave at 3100 */ } }
    ];

    let phaseIndex = 0;
    let skipTimer = 0;

    function startTyping() {
      const typeNext = () => {
        if (charIndex < fullEyebrow.length) {
          eyebrowText.forEach(el => { el.textContent = fullEyebrow.slice(0, charIndex + 1); });
          charIndex++;
          typingTimer = setTimeout(typeNext, 28);
        } else {
          gate.classList.remove('is-typing');
        }
      };
      typeNext();
    }

    function runSequence() {
      if (phaseIndex >= phases.length) return;
      const phase = phases[phaseIndex];
      sequenceTimer = setTimeout(() => {
        phase.fn();
        phaseIndex++;
        runSequence();
      }, phase.delay - (phaseIndex > 0 ? phases[phaseIndex - 1].delay : 0));
    }

    function fastForwardAndLeave() {
      if (isFastForward) return;
      isFastForward = true;

      clearTimeout(typingTimer);
      clearTimeout(sequenceTimer);

      // Finish typing instantly
      eyebrowText.forEach(el => { el.textContent = fullEyebrow; });
      gate.classList.remove('is-typing');
      gate.classList.add('ff', 'letters-in', 'rule-in', 'hint-in');

      // Small pause then leave
      setTimeout(beginLeave, 250);
    }

    function beginLeave() {
      gate.classList.add('is-leaving');

      // Wait for shutter transition to complete
      const handleTransitionEnd = (e) => {
        if (e.target.classList.contains('intro-shutter--bottom')) {
          gate.removeEventListener('transitionend', handleTransitionEnd);
          complete();
        }
      };
      gate.addEventListener('transitionend', handleTransitionEnd);

      // Failsafe if transitionend doesn't fire
      setTimeout(complete, 1500);
    }

    function complete() {
      gate.remove();
      document.documentElement.classList.remove('intro-lock');
      document.dispatchEvent(new CustomEvent('intro:done'));
    }

    // Input handlers for skip
    const skipHandler = (e) => {
      // Allow skip only after letters start (don't skip before seeing anything)
      if (gate.classList.contains('letters-in') || isFastForward) {
        fastForwardAndLeave();
      }
    };

    gate.addEventListener('click', skipHandler);
    document.addEventListener('keydown', skipHandler, { passive: true });
    gate.addEventListener('touchstart', skipHandler, { passive: true });

    // Auto-leave after delay if no interaction
    skipTimer = setTimeout(() => {
      if (!isFastForward && gate.classList.contains('hint-in')) {
        fastForwardAndLeave();
      }
    }, 3200);

    // Start the sequence
    runSequence();

    // Global failsafe
    setTimeout(() => {
      if (document.getElementById('intro-gate')) {
        fastForwardAndLeave();
      }
    }, 9000);
  }
</script>