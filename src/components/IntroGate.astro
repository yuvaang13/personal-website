---
// IntroGate.astro - Scroll-driven split-shutter intro (no auto-play, no click hint)
// Shutter progress is tied to window.scrollY — user scrolls to reveal content.

const rawPath = (Astro.url.pathname.replace(/\/$/, '') || '/');
const introMap: Record<string, { title: string; eyebrow: string }> = {
  '/': { title: 'Yuvaan Gulati.', eyebrow: '~/yuvaan_gulati --init portfolio' },
  '/about': { title: 'About Me.', eyebrow: '~/about_me --cat profile.md' },
  '/projects': { title: 'Projects.', eyebrow: '~/projects --ls -la' },
  '/experience': { title: 'Experience.', eyebrow: '~/experience --timeline' },
  '/contact': { title: 'Contact.', eyebrow: '~/contact --ping' },
};
const cfg = introMap[rawPath] ?? { title: 'Yuvaan Gulati.', eyebrow: `~${rawPath} --init` };
---

<div id="intro-gate" class="intro-gate" aria-hidden="true" role="presentation" data-eyebrow={cfg.eyebrow}>
  <script is:inline>
    (() => {
      try {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) {
          document.documentElement.classList.add('intro-skip');
        }
      } catch (_) {}
    })();
  </script>

  <div class="intro-shutter intro-shutter--top">
    <div class="intro-stage">
      <p class="intro-eyebrow"><span class="intro-eyebrow__text">{cfg.eyebrow}</span><span class="intro-caret" aria-hidden="true"></span></p>
      <h2 class="intro-name" aria-hidden="true">
        {cfg.title.split('').map((ch, i) => (
          <span class="intro-letter" style={`--letter-i: ${i}`}><span class="intro-letter__inner">{ch === ' ' ? '\u00A0' : ch}</span></span>
        ))}
      </h2>
      <div class="intro-rule"></div>
    </div>
  </div>
  <div class="intro-shutter intro-shutter--bottom">
    <div class="intro-stage">
      <p class="intro-eyebrow" aria-hidden="true"><span class="intro-eyebrow__text">{cfg.eyebrow}</span><span class="intro-caret" aria-hidden="true"></span></p>
      <h2 class="intro-name" aria-hidden="true">
        {cfg.title.split('').map((ch, i) => (
          <span class="intro-letter" style={`--letter-i: ${i}`}><span class="intro-letter__inner">{ch === ' ' ? '\u00A0' : ch}</span></span>
        ))}
      </h2>
      <div class="intro-rule" aria-hidden="true"></div>
    </div>
  </div>
</div>

<style>
  .intro-gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: transparent;
    pointer-events: none;
    --intro-progress: 0;
  }

  .intro-shutter {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50.05%;
    overflow: hidden;
    background: var(--color-bg);
    will-change: transform;
  }

  .intro-shutter--top {
    top: 0;
    border-bottom: 1px solid var(--color-border);
    transform: translateY(calc(var(--intro-progress) * -101%));
  }

  .intro-shutter--bottom {
    bottom: 0;
    border-top: 1px solid var(--color-border);
    transform: translateY(calc(var(--intro-progress) * 101%));
  }

  .intro-stage {
    position: absolute;
    left: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem;
    box-sizing: border-box;
    opacity: calc(1 - var(--intro-progress) * 0.9);
    filter: blur(calc(var(--intro-progress) * 8px));
    transform: scale(calc(1 - var(--intro-progress) * 0.04));
    will-change: opacity, filter, transform;
  }

  .intro-shutter--top .intro-stage {
    top: 0;
  }

  .intro-shutter--bottom .intro-stage {
    bottom: 0;
  }

  .intro-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(0.65rem, 1.2vw, 0.85rem);
    letter-spacing: 0.22em;
    text-transform: lowercase;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    opacity: 1;
    transform: translateY(0);
  }

  .intro-eyebrow__text {
    display: inline-block;
    vertical-align: bottom;
  }

  .intro-caret {
    display: inline-block;
    width: 0.7ch;
    height: 1.1em;
    margin-left: 0.3ch;
    background: currentColor;
    vertical-align: bottom;
    animation: caret-blink 1s steps(2) infinite;
    opacity: 0.9;
  }

  @keyframes caret-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .intro-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 7.5vw, 7.5rem);
    line-height: 1.0;
    letter-spacing: -0.02em;
    text-wrap: balance;
    text-align: center;
    margin: 0;
    opacity: 1;
  }

  .intro-letter {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    opacity: 1;
    transform: translateY(0);
  }

  .intro-letter__inner {
    display: block;
  }

  .intro-rule {
    width: 100%;
    max-width: 420px;
    height: 1px;
    background: var(--color-text-primary);
    opacity: 1;
  }

  .intro-gate.is-done {
    display: none !important;
  }

  html.intro-skip .intro-gate {
    display: none !important;
  }
</style>

<script>
  const gate = document.getElementById('intro-gate');
  if (!gate) {
    document.dispatchEvent(new CustomEvent('intro:done'));
  } else if (document.documentElement.classList.contains('intro-skip')) {
    gate.remove();
    document.dispatchEvent(new CustomEvent('intro:done'));
  } else {
    const threshold = () => window.innerHeight * 0.85;
    let done = false;
    let rafId = 0;

    const update = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      const progress = Math.min(1, Math.max(0, scrollY / threshold()));
      gate.style.setProperty('--intro-progress', progress.toFixed(4));

      if (progress >= 0.995 && !done) {
        done = true;
        gate.classList.add('is-done');
        // keep gate in DOM but hidden, allow scroll-reveal to run
        document.dispatchEvent(new CustomEvent('intro:done'));
        // fully remove after a short delay to avoid flash
        setTimeout(() => {
          if (gate.parentNode) gate.remove();
        }, 400);
      } else if (progress < 0.98 && done) {
        // if user scrolls back up, re-show (optional — keeps it reversible)
        done = false;
        gate.classList.remove('is-done');
      }
    };

    const onScroll = () => {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = 0;
        update();
      });
    };

    // initial state — gate closed at top
    gate.style.setProperty('--intro-progress', '0');
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Also poll via rAF for Lenis smooth scroll (which animates scrollY via rAF)
    let lastY = -1;
    const poll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      if (y !== lastY) {
        lastY = y;
        update();
      }
      if (!done) requestAnimationFrame(poll);
    };
    requestAnimationFrame(poll);

    // failsafe: if user never scrolls, gate stays — but we still allow interaction
    // no auto-leave, no click/key handlers — purely scroll-driven
  }
</script>
