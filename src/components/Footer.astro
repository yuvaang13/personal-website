---
// Footer.astro - Site footer with contact links

import { profile } from '@/data/profile';
---

<footer data-od-id="site-footer" class="relative z-10 border-t border-mistral-border bg-mistral-bg" role="contentinfo">
  <!-- Availability band -->
  <div class="border-b border-mistral-border">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 sm:px-8 md:flex-row md:items-center md:justify-between">
      <p class="inline-flex items-center gap-3 text-sm text-mistral-textSecondary">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span><strong class="font-medium text-mistral-text">Open to collaborations</strong> — research, AI/ML builds, STEM education, robotics</span>
      </p>
      <a href="/contact" class="btn-secondary !h-10 !px-5 !text-[13px]">
        Get in touch
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 19l7-7m0 0l-7-7m7 7H3" />
        </svg>
      </a>
    </div>
  </div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-5 py-16 sm:px-8 md:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <p class="font-serif text-base tracking-tight text-mistral-text">{profile.name}</p>
      <p class="mt-3 max-w-sm text-sm leading-6 text-mistral-textMuted">Student developer building AI tools, robotics systems, and STEM learning projects — including mentoring a FIRST LEGO League team at Bicentennial Elementary School.</p>
    </div>

    <nav aria-label="Sitemap">
      <p class="eyebrow">sitemap</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/" class="focus-ring text-mistral-textSecondary transition-colors hover:text-mistral-text hover:underline underline-offset-4">~/ — Home</a></li>
        <li><a href="/projects" class="focus-ring text-mistral-textSecondary transition-colors hover:text-mistral-text hover:underline underline-offset-4">projects/ — Work</a></li>
        <li><a href="/about" class="focus-ring text-mistral-textSecondary transition-colors hover:text-mistral-text hover:underline underline-offset-4">about_me — About</a></li>
        <li><a href="/experience" class="focus-ring text-mistral-textSecondary transition-colors hover:text-mistral-text hover:underline underline-offset-4">experience — Timeline</a></li>
        <li><a href="/contact" class="focus-ring text-mistral-textSecondary transition-colors hover:text-mistral-text hover:underline underline-offset-4">contact — Reach out</a></li>
      </ul>
    </nav>

    <div>
      <p class="eyebrow">connect</p>
      <div class="mt-4 flex flex-col gap-2.5 text-sm text-mistral-textSecondary">
      <a
        href={profile.github}
        target="_blank"
        rel="noreferrer"
        class="focus-ring inline-flex items-center gap-2 underline-offset-4 transition-colors hover:text-mistral-text hover:underline"
        aria-label="GitHub"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        GitHub
      </a>

      <a
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
        class="focus-ring inline-flex items-center gap-2 underline-offset-4 transition-colors hover:text-mistral-text hover:underline"
        aria-label="LinkedIn"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" />
        </svg>
        LinkedIn
      </a>

      <a
        href={`mailto:${profile.email}`}
        class="focus-ring inline-flex items-center gap-2 underline-offset-4 transition-colors hover:text-mistral-text hover:underline"
        aria-label="Email"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Email
      </a>

      <span class="inline-flex items-center gap-2 text-mistral-textMuted" aria-label="Location">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {profile.location}
      </span>
      </div>
    </div>
  </div>

  <div class="border-t border-mistral-border">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-5 py-6 text-xs text-mistral-textMuted sm:px-8 md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} {profile.name}. All rights reserved.</p>
      <p>Designed &amp; built with Astro · Deployed on Vercel</p>
    </div>
  </div>
</footer>
