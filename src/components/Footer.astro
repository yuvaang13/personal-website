---
// Footer.astro - Site footer with contact links

import { profile } from '@/data/profile';
---

<footer data-od-id="site-footer" class="relative z-10 border-t border-mistral-text bg-mistral-bg" role="contentinfo">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-12 text-sm text-mistral-textSecondary sm:px-8 md:flex-row md:items-center md:justify-between">
    <p class="font-serif text-base tracking-tight text-mistral-text">{profile.name}</p>

    <div class="flex flex-wrap items-center gap-6">
      <a
        href={profile.github}
        target="_blank"
        rel="noreferrer"
        class="focus-ring inline-flex items-center gap-2 underline-offset-4 transition-colors hover:text-mistral-text hover:underline"
        aria-label="GitHub"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        GitHub
      </a>

      <a
        href={`mailto:${profile.email}`}
        class="focus-ring inline-flex items-center gap-2 underline-offset-4 transition-colors hover:text-mistral-text hover:underline"
        aria-label="Email"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Email
      </a>

      <span class="inline-flex items-center gap-2 text-mistral-textMuted" aria-label="Location">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {profile.location}
      </span>
    </div>
  </div>
</footer>
