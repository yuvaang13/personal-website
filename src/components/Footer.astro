---
// Footer.astro — the closing plate of the monograph.

import Arrow from '@/components/Arrow.astro';
import { profile } from '@/data/profile';

const sitemap = [
  { href: '/', label: 'Home', note: 'Index' },
  { href: '/projects', label: 'Projects', note: 'Work' },
  { href: '/about', label: 'About', note: 'Profile' },
  { href: '/experience', label: 'Experience', note: 'Timeline' },
  { href: '/contact', label: 'Contact', note: 'Reach out' },
];

const connect = [
  { href: profile.github, label: 'GitHub', external: true },
  { href: profile.linkedin, label: 'LinkedIn', external: true },
  { href: `mailto:${profile.email}`, label: 'Email', external: false },
];
---

<footer class="foot" role="contentinfo" data-od-id="site-footer">
  <div class="wrap">
    <div class="foot__top">
      <p class="foot__status">
        <span class="foot__dot" aria-hidden="true"></span>
        <strong>Open to collaborations</strong>
      </p>
      <p class="foot__status-note">Research, AI/ML builds, STEM education, robotics</p>
      <a href="/contact" class="foot__cta">
        Get in touch
        <Arrow size={14} />
      </a>
    </div>

    <div class="foot__cols">
      <div class="foot__brand">
        <p class="foot__blurb">
          Student developer building AI tools, robotics systems, and STEM learning projects —
          including mentoring a FIRST LEGO League team at Bicentennial Elementary School.
        </p>
        <p class="foot__loc mono">Greater Boston · Massachusetts</p>
      </div>

      <nav class="foot__col" aria-label="Sitemap">
        <p class="foot__label mono">Sitemap</p>
        <ul class="foot__list">
          {sitemap.map((item) => (
            <li>
              <a href={item.href} class="foot__link">
                <span>{item.label}</span>
                <span class="mono">{item.note}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="foot__col">
        <p class="foot__label mono">Connect</p>
        <ul class="foot__list">
          {connect.map((item) => (
            <li>
              <a
                href={item.href}
                class="foot__link"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noreferrer' : undefined}
              >
                <span>{item.label}</span>
                <Arrow size={13} />
              </a>
            </li>
          ))}
          <li>
            <span class="foot__link foot__link--static">
              <span>Location</span>
              <span class="mono">{profile.location}</span>
            </span>
          </li>
        </ul>
      </div>
    </div>

    <p class="foot__signature">Yuvaan Gulati</p>

    <div class="foot__base">
      <p>© {new Date().getFullYear()} {profile.name}. All rights reserved.</p>
      <p>Designed &amp; built with Astro · Deployed on Vercel</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 10;
    background: var(--night);
    color: var(--night-text);
    overflow: hidden;
  }

  .foot__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.75rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid rgba(244, 239, 227, 0.16);
  }

  .foot__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.86rem;
  }

  .foot__status strong {
    font-weight: 500;
  }

  .foot__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--night-text);
  }

  .foot__status-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--night-muted);
  }

  .foot__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    min-height: 2.6rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--night-text);
    color: var(--night-text);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .foot__cta:hover {
    background: var(--night-text);
    color: var(--night);
  }

  .foot__cta :global(svg) {
    transition: transform 220ms ease;
  }

  .foot__cta:hover :global(svg) {
    transform: translate(3px, -3px);
  }

  .foot__cols {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .foot__blurb {
    margin: 0;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--night-text);
    text-wrap: pretty;
  }

  .foot__loc {
    margin-top: 1.6rem;
    color: var(--night-muted);
  }

  .foot__label {
    margin: 0 0 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(244, 239, 227, 0.16);
    color: var(--night-muted);
  }

  .foot__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(244, 239, 227, 0.1);
    color: var(--night-text);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 180ms ease, padding-left 180ms ease;
  }

  a.foot__link:hover {
    padding-left: 0.35rem;
    color: var(--night-muted);
  }

  .foot__link .mono {
    color: var(--night-muted);
    font-size: 0.52rem;
  }

  .foot__link :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--night-muted);
    transition: transform 200ms ease;
  }

  a.foot__link:hover :global(svg) {
    transform: translate(2px, -2px);
  }

  .foot__link--static {
    cursor: default;
  }

  .foot__signature {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(244, 239, 227, 0.16);
    font-family: var(--font-display);
    font-size: clamp(3rem, 12.5vw, 11rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: var(--night-text);
    white-space: nowrap;
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 1.75rem;
    color: var(--night-muted);
    font-size: 0.72rem;
  }

  .foot__base p {
    margin: 0;
  }

  .foot :global(:focus-visible) {
    outline-color: var(--night-text);
  }

  @media (max-width: 900px) {
    .foot__cols {
      grid-template-columns: 1fr 1fr;
    }

    .foot__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .foot__top {
      align-items: flex-start;
    }

    .foot__cta {
      margin-left: 0;
    }

    .foot__cols {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .foot__signature {
      font-size: clamp(2.4rem, 13vw, 5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__cta,
    .foot__cta :global(svg),
    .foot__link,
    .foot__link :global(svg) {
      transition: none;
    }
  }
</style>
