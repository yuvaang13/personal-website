---
// CursorField.astro - Cursor-drawn neural web with math/CS glyphs
// Global component rendered in PageShell
---

<canvas id="cursor-field" class="cursor-field" aria-hidden="true"></canvas>

<style>
  .cursor-field {
    position: fixed;
    inset: 0;
    z-index: 30;
    pointer-events: none;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-field {
      display: none !important;
    }
  }
</style>

<script>
  (() => {
    const canvasEl = document.getElementById('cursor-field') as HTMLCanvasElement | null;
    if (!canvasEl) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hasFinePointer = window.matchMedia('(pointer: fine)').matches;
    if (prefersReduced || !hasFinePointer) {
      canvasEl.remove();
      return;
    }

    const ctx = canvasEl.getContext('2d', { alpha: true });
    if (!ctx) {
      canvasEl.remove();
      return;
    }

    let width = 0;
    let height = 0;
    let dpr = 1;
    let rafId = 0;
    let lastMoveTime = 0;

    const MAX_NODES = 120;
    const nodes: { x: number; y: number; vx: number; vy: number; life: number; maxLife: number; size: number }[] = [];

    const MAX_GLYPHS = 40;
    const glyphs: { x: number; y: number; char: string; life: number; maxLife: number; vy: number; alpha: number; size: number; rot: number }[] = [];
    const GLYPH_CHARS = ['\u2211', '\u03c0', '\u03bb', '\u2207', '\u03b8', '\u0394', '\u2202', '\u221e', '\u221a', '01', 'AI', 'ML', '\u222b'];

    const CONNECT_DIST = 160;
    const CONNECT_MAX = 3;

    function resize() {
      const rect = canvasEl!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvasEl!.width = Math.floor(width * dpr);
      canvasEl!.height = Math.floor(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function spawnNode(x: number, y: number) {
      if (nodes.length >= MAX_NODES) nodes.shift();
      nodes.push({
        x,
        y,
        vx: (Math.random() - 0.5) * 0.12,
        vy: (Math.random() - 0.5) * 0.12,
        life: 1,
        maxLife: 1.8 + Math.random() * 0.6,
        size: 1.6 + Math.random() * 1.2,
      });
    }

    function maybeSpawnGlyph(x: number, y: number) {
      if (glyphs.length >= MAX_GLYPHS) return;
      if (Math.random() > 0.18) return;
      const char = GLYPH_CHARS[Math.floor(Math.random() * GLYPH_CHARS.length)];
      glyphs.push({
        x,
        y,
        char,
        life: 1,
        maxLife: 1.4 + Math.random() * 0.5,
        vy: -0.12 - Math.random() * 0.08,
        alpha: 0.35 + Math.random() * 0.25,
        size: 9 + Math.random() * 5,
        rot: (Math.random() - 0.5) * 0.04,
      });
    }

    function draw() {
      const now = performance.now();
      const dt = Math.min(32, now - lastMoveTime);
      lastMoveTime = now;

      ctx!.clearRect(0, 0, width, height);

      for (let i = nodes.length - 1; i >= 0; i--) {
        const n = nodes[i];
        n.life -= dt / 1000 / n.maxLife;
        if (n.life <= 0) {
          nodes.splice(i, 1);
          continue;
        }
        n.x += n.vx * dt;
        n.y += n.vy * dt;
        const cx = width * 0.5 - n.x;
        const cy = height * 0.5 - n.y;
        const distC = Math.hypot(cx, cy);
        if (distC > 200) {
          n.vx += cx * 0.000002 * dt;
          n.vy += cy * 0.000002 * dt;
        }
        n.vx *= 0.996;
        n.vy *= 0.996;
      }

      for (let i = glyphs.length - 1; i >= 0; i--) {
        const g = glyphs[i];
        g.life -= dt / 1000 / g.maxLife;
        if (g.life <= 0) {
          glyphs.splice(i, 1);
          continue;
        }
        g.y += g.vy * dt;
        g.vy *= 0.99;
        g.rot += 0.0008 * dt * (g.rot > 0 ? 1 : -1);
      }

      ctx!.lineWidth = 0.6;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        let connections = 0;
        for (let j = i + 1; j < nodes.length && connections < CONNECT_MAX; j++) {
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < CONNECT_DIST) {
            const t = 1 - d / CONNECT_DIST;
            const alpha = t * 0.18 * Math.min(a.life, b.life);
            ctx!.strokeStyle = `rgba(0, 0, 0, ${alpha})`;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.stroke();
            connections++;
          }
        }
      }

      for (const n of nodes) {
        const alpha = 0.35 * n.life;
        const r = n.size * n.life;
        ctx!.fillStyle = `rgba(0, 0, 0, ${alpha})`;
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, r, 0, Math.PI * 2);
        ctx!.fill();
      }

      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';
      for (const g of glyphs) {
        const alpha = g.alpha * g.life;
        ctx!.fillStyle = `rgba(0, 0, 0, ${alpha})`;
        ctx!.save();
        ctx!.translate(g.x, g.y);
        ctx!.rotate(g.rot);
        ctx!.font = `${g.size}px Space Mono, monospace`;
        ctx!.fillText(g.char, 0, 0);
        ctx!.restore();
      }

      if (nodes.length > 0 || glyphs.length > 0) {
        rafId = requestAnimationFrame(draw);
      } else {
        rafId = 0;
      }
    }

    function onPointerMove(e: MouseEvent) {
      const rect = canvasEl!.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const last = nodes[nodes.length - 1];
      if (!last || Math.hypot(x - last.x, y - last.y) >= 12) {
        spawnNode(x, y);
        maybeSpawnGlyph(x, y);
      }
      if (!rafId) {
        lastMoveTime = performance.now();
        rafId = requestAnimationFrame(draw);
      }
    }

    function onPointerLeave() {}

    let resizeTimer = 0;
    function onResize() {
      clearTimeout(resizeTimer);
      // @ts-ignore
      resizeTimer = setTimeout(resize, 100) as unknown as number;
    }

    resize();
    window.addEventListener('resize', onResize, { passive: true });
    canvasEl.addEventListener('mousemove', onPointerMove, { passive: true });
    canvasEl.addEventListener('mouseleave', onPointerLeave);
  })();
</script>
