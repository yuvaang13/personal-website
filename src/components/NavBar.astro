---
// NavBar.astro - Liquid glass top bar with navigation + status labels

import { navItems } from '@/data/profile';
const currentPath = Astro.url.pathname;
---

<header data-od-id="site-nav" class="fixed inset-x-0 top-0 z-50 pointer-events-none">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="pointer-events-auto flex items-center justify-between gap-4 py-3 sm:py-4">
      {/* Brand */}
      <div class="flex min-w-0 items-center">
        <a
          href="/"
          class="focus-ring shrink-0 font-serif text-base tracking-tight text-mistral-text transition-opacity hover:opacity-70 sm:text-lg"
          aria-label="Home"
        >
          yuvaan_gulati
        </a>
      </div>

      {/* Primary navigation */}
      <div
        class="hidden lg:flex items-center gap-1"
        role="navigation"
        aria-label="Site sections"
      >
        {navItems.map((item) => {
          const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);

          if (item.href === '/contact') {
            return (
              <a
                key={item.href}
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class="focus-ring inline-flex h-9 shrink-0 items-center rounded-full bg-mistral-accent px-5 text-sm font-medium text-mistral-bg transition-colors hover:bg-[#e5e5e5]"
              >
                {item.label}
              </a>
            );
          }

          return (
            <a
              key={item.href}
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`focus-ring whitespace-nowrap rounded-full px-3 py-2 text-sm transition-colors hover:bg-mistral-accentDim sm:px-4 ${
                isActive ? 'font-medium text-mistral-text' : 'text-mistral-textSecondary hover:text-mistral-text'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </div>

      {/* Availability details are deliberately secondary to the navigation. */}
      <div class="hidden xl:flex items-center gap-5 whitespace-nowrap">
        <div>
          <p class="text-[10px] uppercase tracking-widest text-mistral-textMuted">Based</p>
          <p class="text-[11px] font-medium text-mistral-text">Greater Boston</p>
        </div>
        <div>
          <p class="text-[10px] uppercase tracking-widest text-mistral-textMuted">Status</p>
          <p class="mt-0.5 text-[11px] font-medium text-mistral-text flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-[#ff6b35]" aria-hidden="true"></span>
            Open to collaborations
          </p>
        </div>
      </div>

      {/* Mobile menu toggle — the only header action below the lg breakpoint. */}
      <div class="lg:hidden">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="focus-ring inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-mistral-text transition-colors hover:border-mistral-text hover:bg-white/10"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <svg class="mobile-menu-icon-open h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg class="mobile-menu-icon-close hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile dropdown menu */}
  <div
    id="mobile-menu"
    class="mobile-menu lg:hidden"
    hidden
  >
    <div class="mx-auto max-w-7xl px-5 pb-4 pt-2 sm:px-8" role="navigation" aria-label="Site sections">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);

        if (item.href === '/contact') {
          return (
            <a
              key={item.href}
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class="mobile-menu__link focus-ring mt-3 inline-flex h-11 w-full items-center justify-center rounded-full bg-mistral-accent px-5 text-sm font-medium text-mistral-bg transition-colors hover:bg-[#e5e5e5]"
            >
              {item.label}
            </a>
          );
        }

        return (
          <a
            key={item.href}
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`mobile-menu__link focus-ring flex min-h-11 items-center justify-between border-b border-white/10 py-3.5 text-base transition-colors last:border-b-0 ${
              isActive ? 'font-medium text-mistral-text' : 'text-mistral-textSecondary'
            }`}
          >
            {item.label}
            <svg class="h-4 w-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 19l7-7m0 0l-7-7m7 7H3" />
            </svg>
          </a>
        );
      })}
    </div>
  </div>
</header>

<style>
  /* Liquid glass nav bar */
  header[data-od-id="site-nav"] {
    background: rgba(13, 13, 16, 0.8);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Mobile dropdown — continues the glass surface below the bar */
  .mobile-menu {
    pointer-events: auto;
    background: rgba(13, 13, 16, 0.94);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    transform-origin: top center;
  }

  .mobile-menu.is-open {
    animation: mobileMenuDrop 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes mobileMenuDrop {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu.is-open {
      animation: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('.mobile-menu-icon-open');
  const iconClose = toggle?.querySelector('.mobile-menu-icon-close');

  if (toggle && menu) {
    const setMenu = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      menu.classList.toggle('is-open', open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close after choosing a destination
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    // Escape closes and returns focus to the toggle
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        toggle.focus();
      }
    });

    // Click outside the header closes the menu
    document.addEventListener('click', (event) => {
      const header = toggle.closest('header');
      if (
        toggle.getAttribute('aria-expanded') === 'true' &&
        header &&
        event.target instanceof Node &&
        !header.contains(event.target)
      ) {
        setMenu(false);
      }
    });

    // Reset when growing into the desktop layout
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
      }
    }, { passive: true });
  }
</script>
