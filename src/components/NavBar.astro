---
import Arrow from '@/components/Arrow.astro';
import { navItems } from '@/data/profile';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);

const desktopNav = navItems.filter((item) => ['/projects', '/about', '/experience'].includes(item.href));
---

<header class="site-header" data-od-id="site-nav">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label="Yuvaan Gulati — Home">
      <span class="brand__mark" aria-hidden="true">YG</span>
      <span class="brand__text">
        <span class="brand__name">Yuvaan Gulati</span>
        <span class="brand__sub mono">Student developer</span>
      </span>
    </a>

    <nav class="desk-nav" aria-label="Site sections">
      {desktopNav.map((item, index) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={['desk-nav__link', { 'is-active': isActive(item.href) }]}
        >
          <span class="desk-nav__num mono">0{index + 1}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <span class="header-status mono">
        <span class="header-status__dot" aria-hidden="true"></span>
        Open to collaborations
      </span>
      <a
        href="/contact"
        aria-current={isActive('/contact') ? 'page' : undefined}
        class:list={['btn', 'btn--small', 'header-contact', { 'is-active': isActive('/contact') }]}
      >
        Contact
        <Arrow size={14} />
      </a>
      <button
        id="menu-toggle"
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <div class="wrap">
    <nav aria-label="Site sections">
      {navItems.map((item, index) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={['mobile-menu__link', { 'is-active': isActive(item.href) }]}
        >
          <span class="mobile-menu__num mono">0{index + 1}</span>
          <span>{item.label}</span>
          <Arrow size={20} />
        </a>
      ))}
    </nav>
    <div class="mobile-menu__foot">
      <p class="mono">Greater Boston</p>
      <p class="mono">Open to collaborations</p>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--paper);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: var(--nav-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .brand__sub {
    font-size: 0.5rem;
    line-height: 1;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .desk-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
  }

  .desk-nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.38rem;
    color: var(--ink-2);
    font-size: 0.84rem;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .desk-nav__num {
    font-size: 0.5rem;
    color: var(--muted);
    transition: color 180ms ease;
  }

  .desk-nav__link:hover,
  .desk-nav__link.is-active {
    color: var(--ink);
  }

  .desk-nav__link.is-active .desk-nav__num {
    color: var(--ink);
  }

  .desk-nav__link.is-active {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex: none;
  }

  .header-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    white-space: nowrap;
  }

  .header-status__dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--cobalt);
  }

  .header-contact {
    text-decoration: none;
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--ink);
    background: transparent;
    cursor: pointer;
  }

  .menu-toggle__line {
    display: block;
    width: 1.1rem;
    height: 1px;
    margin: 0 auto;
    background: var(--ink);
    transition: transform 200ms ease;
  }

  .menu-toggle__line + .menu-toggle__line {
    margin-top: 0.35rem;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__line:first-child {
    transform: translateY(3.4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__line:last-child {
    transform: translateY(-3.4px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    z-index: 49;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background: var(--paper);
    border-top: 1px solid var(--rule);
    padding: 1.5rem 0 2rem;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu > .wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 7vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mobile-menu__link > span:nth-child(2) {
    flex: 1;
  }

  .mobile-menu__link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    align-self: center;
    color: var(--muted);
  }

  .mobile-menu__num {
    font-size: 0.52rem;
    color: var(--muted);
  }

  .mobile-menu__link.is-active {
    font-style: italic;
  }

  .mobile-menu__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  @media (max-width: 1023px) {
    .desk-nav,
    .header-status,
    .header-contact {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .brand__sub {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__line {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setMenu = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.querySelector<HTMLElement>('a')?.focus();
      }
    };

    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    document.addEventListener('keydown', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;

      if (event.key === 'Escape') {
        setMenu(false);
        toggle.focus();
        return;
      }

      if (event.key === 'Tab') {
        const links = Array.from(menu.querySelectorAll<HTMLElement>('a[href]'));
        if (links.length === 0) return;
        const first = links[0];
        const last = links[links.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth >= 1024 && toggle.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
        }
      },
      { passive: true }
    );
  }
</script>
