---
// NavBar.astro - Fixed navigation bar with dev-terminal aesthetic

import { navItems } from '@/data/profile';
const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-zinc-800/80 bg-black/75 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8" aria-label="Main navigation">
    <a
      href="/"
      class="focus-ring shrink-0 text-sm font-medium tracking-tight text-white transition-opacity hover:opacity-80"
      aria-label="Home"
    >
      yuvaan_gulati
    </a>

    <div class="flex items-center gap-1 overflow-x-auto" role="navigation" aria-label="Site sections">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`focus-ring whitespace-nowrap rounded-full px-3 py-2 text-xs transition duration-300 hover:bg-white/[0.04] hover:text-white sm:px-4 sm:text-sm ${
              isActive ? 'text-white' : 'text-zinc-500'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<style>
  /* Hide scrollbar for nav overflow */
  nav div::-webkit-scrollbar {
    display: none;
  }
  nav div {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>