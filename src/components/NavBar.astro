---
// NavBar.astro - Fixed navigation bar, Mistral editorial style

import { navItems } from '@/data/profile';
const currentPath = Astro.url.pathname;
---

<header data-od-id="site-nav" class="fixed inset-x-0 top-0 z-50 border-b border-mistral-border bg-mistral-bg/85 backdrop-blur-xl">
  <nav class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8" aria-label="Main navigation">
    <a
      href="/"
      class="focus-ring shrink-0 font-serif text-lg tracking-tight text-mistral-text transition-opacity hover:opacity-70"
      aria-label="Home"
    >
      yuvaan_gulati
    </a>

    <div class="flex items-center gap-1 overflow-x-auto sm:gap-2" role="navigation" aria-label="Site sections">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);

        if (item.href === '/contact') {
          return (
            <a
              key={item.href}
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class="focus-ring inline-flex h-9 shrink-0 items-center rounded-full bg-mistral-text px-5 text-sm font-medium text-white transition-colors hover:bg-[#1c1c1c]"
            >
              {item.label}
            </a>
          );
        }

        return (
          <a
            key={item.href}
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`focus-ring whitespace-nowrap rounded-full px-3 py-2 text-sm transition-colors hover:bg-mistral-accentDim sm:px-4 ${
              isActive ? 'font-medium text-mistral-text' : 'text-mistral-textSecondary hover:text-mistral-text'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<style>
  /* Hide scrollbar for nav overflow */
  nav div::-webkit-scrollbar {
    display: none;
  }
  nav div {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
