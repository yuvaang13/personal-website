---
/**
 * Glass Folder Cards — native Astro port of the self-contained React component.
 *
 * Three real layers: a back panel holding artwork, the files inside the folder,
 * and a frosted-glass front panel that blurs whatever sits behind it. Hover to
 * lean the glass on its bottom hinge, click to open and fan the files, use the
 * key to add a file or open the frosted menu. Keyboard and reduced-motion aware.
 *
 * The artwork is generated in glassArt.ts (no network, no image assets required),
 * but an `image` URL can be supplied for the back panel and for individual files.
 */
import { hashString, rng, fanSlot } from './glassArt';

type FolderFile = {
  name: string;
  meta?: string;
  art?: string;
  image?: string;
  href?: string;
};

interface Props {
  label?: string;
  meta?: string;
  tone?: 'light' | 'dark';
  art?: string;
  seed?: number;
  image?: string;
  files?: FolderFile[];
  action?: 'add' | 'more' | 'none';
  menu?: Array<{ label: string; danger?: boolean }>;
  labelPlacement?: 'bottom-left' | 'top-left' | 'top-right';
  width?: number;
  defaultOpen?: boolean;
  appear?: boolean;
  appearDelay?: number;
  class?: string;
}

const {
  label = 'My Files',
  meta,
  tone = 'light',
  art = 'graphite',
  seed = 3,
  image,
  files = [],
  action = 'add',
  menu = [],
  labelPlacement = 'bottom-left',
  width = 340,
  defaultOpen = false,
  appear = true,
  appearDelay = 0,
  class: className = '',
} = Astro.props;

const W = 340;
const H = 272;
const HEADROOM = 54;
const SHEET_W = 272;
const SHEET_H = 184;
const MAX_VISIBLE = 4;

const BACK_PATH =
  'M0 56A22 22 0 0 1 22 34L146 34C170 34 172 0 198 0L318 0A22 22 0 0 1 340 22L340 250A22 22 0 0 1 318 272L22 272A22 22 0 0 1 0 250Z';
const FRONT_H = H - 74;
const FRONT_PATH =
  'M0 22A22 22 0 0 1 22 0L118 0C144 0 146 32 172 32L318 32A22 22 0 0 1 340 54L340 ' +
  (FRONT_H - 22) +
  'A22 22 0 0 1 318 ' +
  FRONT_H +
  'L22 ' +
  FRONT_H +
  'A22 22 0 0 1 0 ' +
  (FRONT_H - 22) +
  'Z';

const uid = Math.random().toString(36).slice(2, 10);
const k = width / W;
const start = Math.max(0, files.length - MAX_VISIBLE);
const visible = files.slice(start);
const count = files.length;
const metaLine = meta ?? `${count} ${count === 1 ? 'item' : 'items'}`;

const artData = (artKey: string, artSeed: number, w: number, h: number, priority: number) => ({
  'data-gf-art': artKey,
  'data-gf-seed': artSeed,
  'data-gf-w': w,
  'data-gf-h': h,
  'data-gf-density': k,
  'data-gf-priority': priority,
});

const sheetStyle = (file: FolderFile, v: number) => {
  const jitter = rng(hashString(file.name) + start + v);
  const slot = fanSlot(v, visible.length);
  const x = ((jitter() - 0.5) * 10).toFixed(2);
  const r = ((jitter() - 0.5) * 3.2).toFixed(2);
  return `--gf-slot:${slot};--gf-depth:${visible.length - 1 - v};--gf-jx:${x}px;--gf-jr:${r}deg;z-index:${v + 1};`;
};
---

<div
  class={`gf-root ${className}`.trim()}
  data-tone={tone}
  data-open={defaultOpen ? '' : undefined}
  data-place={labelPlacement}
  data-appear={appear ? '' : undefined}
  data-appear-delay={appearDelay}
  style={`width:${width}px;height:${(H + HEADROOM) * k}px;`}
>
  <div class="gf-stage" style={`transform:translateY(${HEADROOM * k}px) scale(${k})`}>
    <div class="gf-tilt">
      <div class="gf-shadow" aria-hidden="true"></div>

      {/* back panel + its artwork */}
      <div class="gf-back" style={`clip-path:path('${BACK_PATH}')`} aria-hidden="true">
        {art !== 'none' && (
          <canvas class="gf-art" {...artData(art, seed, W + 24, H + 24, 0)} aria-hidden="true"></canvas>
        )}
        {image && (
          <img
            class="gf-art gf-photo"
            src={image}
            alt=""
            width={W + 24}
            height={H + 24}
            draggable="false"
            loading="lazy"
          />
        )}
        <div class="gf-back-sheen"></div>
      </div>
      <svg class="gf-rim gf-back-rim" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        <path d={BACK_PATH}></path>
      </svg>

      {/* frosted front panel, hinged on its bottom edge */}
      <div class="gf-front" style={`clip-path:path('${FRONT_PATH}')`}>
        <div class="gf-tint" aria-hidden="true"></div>
        <div class="gf-spec" aria-hidden="true"></div>
        <svg class="gf-rim gf-front-rim" viewBox={`0 0 ${W} ${FRONT_H}`} aria-hidden="true">
          <defs>
            <linearGradient id={`gf-rim-${uid}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity="0.95"></stop>
              <stop offset="0.35" stop-color="#fff" stop-opacity="0.35"></stop>
              <stop offset="1" stop-color="#fff" stop-opacity="0.12"></stop>
            </linearGradient>
          </defs>
          <path d={FRONT_PATH} stroke={`url(#gf-rim-${uid})`}></path>
        </svg>
        <button
          type="button"
          class="gf-hit"
          aria-expanded={defaultOpen ? 'true' : 'false'}
          aria-label={`${defaultOpen ? 'Close' : 'Open'} ${label}, ${count} ${count === 1 ? 'item' : 'items'}`}
        ></button>
        <div class="gf-label">
          <span class="gf-title">{label}</span>
          <span class="gf-meta" data-gf-meta>{metaLine}</span>
        </div>
      </div>

      {/* the contents: after the glass in tab order, beneath it on screen */}
      <div class="gf-files" role="list" aria-label={`${label} contents`} inert={!defaultOpen}>
        {visible.map((file, v) => (
          <div role="listitem" class="gf-sheet-slot">
            {file.href ? (
              <a
                class={`gf-sheet ${file.art || file.image ? 'gf-sheet--art' : ''}`}
                style={sheetStyle(file, v)}
                href={file.href}
                data-gf-file={file.name}
              >
                <span class="gf-sheet-inner">
                  {file.art || file.image ? (
                    <>
                      {file.art && (
                        <canvas
                          class="gf-sheet-art"
                          {...artData(file.art, hashString(file.name) % 997, SHEET_W, SHEET_H, 1)}
                          aria-hidden="true"
                        ></canvas>
                      )}
                      {file.image && (
                        <img
                          class="gf-sheet-art gf-photo"
                          src={file.image}
                          alt=""
                          width={SHEET_W}
                          height={SHEET_H}
                          draggable="false"
                          loading="lazy"
                        />
                      )}
                    </>
                  ) : (
                    <span class="gf-lines" aria-hidden="true">
                      <i style="width:86%"></i>
                      <i style="width:92%"></i>
                      <i style="width:64%"></i>
                      <i style="width:88%"></i>
                      <i style="width:42%"></i>
                    </span>
                  )}
                  <span class="gf-sheet-head">
                    <span class="gf-sheet-name">{file.name}</span>
                    {file.meta && <span class="gf-sheet-meta">{file.meta}</span>}
                  </span>
                </span>
              </a>
            ) : (
              <button
                type="button"
                class={`gf-sheet ${file.art || file.image ? 'gf-sheet--art' : ''}`}
                style={sheetStyle(file, v)}
                data-gf-file={file.name}
              >
                <span class="gf-sheet-inner">
                  {file.art || file.image ? (
                    <>
                      {file.art && (
                        <canvas
                          class="gf-sheet-art"
                          {...artData(file.art, hashString(file.name) % 997, SHEET_W, SHEET_H, 1)}
                          aria-hidden="true"
                        ></canvas>
                      )}
                      {file.image && (
                        <img
                          class="gf-sheet-art gf-photo"
                          src={file.image}
                          alt=""
                          width={SHEET_W}
                          height={SHEET_H}
                          draggable="false"
                          loading="lazy"
                        />
                      )}
                    </>
                  ) : (
                    <span class="gf-lines" aria-hidden="true">
                      <i style="width:86%"></i>
                      <i style="width:92%"></i>
                      <i style="width:64%"></i>
                      <i style="width:88%"></i>
                      <i style="width:42%"></i>
                    </span>
                  )}
                  <span class="gf-sheet-head">
                    <span class="gf-sheet-name">{file.name}</span>
                    {file.meta && <span class="gf-sheet-meta">{file.meta}</span>}
                  </span>
                </span>
              </button>
            )}
          </div>
        ))}
      </div>

      {action !== 'none' && (
        <button
          type="button"
          class={`gf-key gf-key--${action}`}
          aria-label={action === 'add' ? `Add a file to ${label}` : `More options for ${label}`}
          aria-haspopup={action === 'more' ? 'menu' : undefined}
          aria-expanded={action === 'more' ? 'false' : undefined}
          aria-controls={action === 'more' ? `gf-menu-${uid}` : undefined}
        >
          {action === 'add' ? (
            <svg class="gf-glyph gf-glyph--plus" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4.5v15M4.5 12h15"></path>
            </svg>
          ) : (
            <svg class="gf-glyph gf-glyph--more" viewBox="0 0 30 12" aria-hidden="true">
              <rect x="1" y="1.5" width="8" height="9" rx="3.4"></rect>
              <rect x="11" y="1.5" width="8" height="9" rx="3.4"></rect>
              <rect x="21" y="1.5" width="8" height="9" rx="3.4"></rect>
            </svg>
          )}
        </button>
      )}

      {action === 'more' && (
        <div
          class="gf-menu"
          id={`gf-menu-${uid}`}
          role="menu"
          aria-label={`${label} options`}
        >
          <button type="button" role="menuitem" class="gf-menu-item" data-gf-menu-toggle>
            {defaultOpen ? 'Close folder' : 'Open folder'}
          </button>
          {menu.map((item) => (
            <button
              type="button"
              role="menuitem"
              class={`gf-menu-item ${item.danger ? 'gf-menu-item--danger' : ''}`}
              data-gf-menu-label={item.label}
            >
              {item.label}
            </button>
          ))}
        </div>
      )}
    </div>
  </div>
</div>

<script>
  import { paintArtworks, folderHash, folderRng } from './glassArt';

  function initFolder(root: HTMLElement) {
    const hit = root.querySelector<HTMLButtonElement>('.gf-hit')!;
    const files = root.querySelector<HTMLElement>('.gf-files')!;
    const key = root.querySelector<HTMLButtonElement>('.gf-key')!;
    const menu = root.querySelector<HTMLElement>('.gf-menu');
    const meta = root.querySelector<HTMLElement>('[data-gf-meta]');
    const label = root.querySelector<HTMLElement>('.gf-title')?.textContent?.trim() || 'folder';

    let isOpen = root.hasAttribute('data-open');
    let menuOpen = false;
    let count = Number((meta?.textContent || '').match(/^(\d+)/)?.[1] ?? files.querySelectorAll('.gf-sheet').length);
    const explicitMeta = Boolean(meta?.textContent && !/^\d+ items?$/.test(meta.textContent.trim()));

    const setOpen = (next: boolean) => {
      isOpen = next;
      root.toggleAttribute('data-open', next);
      hit.setAttribute('aria-expanded', String(next));
      hit.setAttribute('aria-label', `${next ? 'Close' : 'Open'} ${label}, ${count} ${count === 1 ? 'item' : 'items'}`);
      files.toggleAttribute('inert', !next);
      const toggle = menu?.querySelector<HTMLElement>('[data-gf-menu-toggle]');
      if (toggle) toggle.textContent = next ? 'Close folder' : 'Open folder';
    };

    const setMenu = (next: boolean) => {
      menuOpen = next;
      if (!menu || !key) return;
      menu.toggleAttribute('data-open', next);
      key.setAttribute('aria-expanded', String(next));
      if (next) {
        menu.querySelector<HTMLElement>('[role="menuitem"]')?.focus();
      }
    };

    setOpen(isOpen);

    hit?.addEventListener('click', () => {
      setMenu(false);
      setOpen(!isOpen);
    });

    // Pointer-driven light + parallax — written straight to CSS vars, no re-render.
    let raf = 0;
    let px = 0;
    let py = 0;
    const write = () => {
      raf = 0;
      root.style.setProperty('--gf-px', px.toFixed(3));
      root.style.setProperty('--gf-py', py.toFixed(3));
    };
    root.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const r = root.getBoundingClientRect();
      px = ((e.clientX - r.left) / r.width) * 2 - 1;
      py = ((e.clientY - r.top) / r.height) * 2 - 1;
      if (!raf) raf = requestAnimationFrame(write);
    });
    root.addEventListener('pointerleave', () => {
      px = 0;
      py = 0;
      if (!raf) raf = requestAnimationFrame(write);
    });

    // Entrance: assemble the first time the folder scrolls into view.
    if (root.hasAttribute('data-appear')) {
      const delay = Number(root.dataset.appearDelay || 0);
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          io.disconnect();
          window.setTimeout(() => root.setAttribute('data-entered', ''), delay);
        }, { threshold: 0.2 });
        io.observe(root);
      } else {
        root.setAttribute('data-entered', '');
      }
    } else {
      root.setAttribute('data-entered', '');
    }

    // A stock image that fails to load simply reveals the generated art beneath it.
    root.querySelectorAll<HTMLImageElement>('img.gf-photo').forEach((img) => {
      img.addEventListener('error', () => { img.style.display = 'none'; }, { once: true });
    });

    key?.addEventListener('click', () => {
      if (key.classList.contains('gf-key--add')) {
        addFile();
      } else {
        setMenu(!menuOpen);
      }
    });

    function addFile() {
      const last = files.querySelector<HTMLElement>('.gf-sheet-slot:last-of-type');
      if (!last) return;
      const clone = last.cloneNode(true) as HTMLElement;
      count += 1;
      const name = `Untitled ${count}`;
      clone.setAttribute('data-gf-file', name);
      const nameEl = clone.querySelector<HTMLElement>('.gf-sheet-name');
      if (nameEl) nameEl.textContent = name;
      const metaEl = clone.querySelector<HTMLElement>('.gf-sheet-meta');
      if (metaEl) metaEl.textContent = 'Just now';
      clone.querySelectorAll<HTMLCanvasElement>('canvas[data-gf-art]').forEach((canvas) => {
        canvas.removeAttribute('data-painted');
        canvas.removeAttribute('data-ready');
        canvas.dataset.gfSeed = String(folderHash(name) % 997);
      });
      const jitter = folderRng(folderHash(name) + count);
      const slot = 1;
      clone.querySelector<HTMLElement>('.gf-sheet')?.setAttribute(
        'style',
        `--gf-slot:${slot};--gf-depth:0;--gf-jx:${((jitter() - 0.5) * 10).toFixed(2)}px;--gf-jr:${((jitter() - 0.5) * 3.2).toFixed(2)}deg;z-index:5;`
      );
      clone.querySelector<HTMLElement>('.gf-sheet')?.classList.add('gf-sheet--drop');
      files.appendChild(clone);
      if (!explicitMeta && meta) {
        meta.textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
        meta.style.animation = 'none';
        void meta.offsetWidth;
        meta.style.animation = '';
      }
      paintArtworks(root);
      window.setTimeout(() => clone.querySelector('.gf-sheet')?.classList.remove('gf-sheet--drop'), 900);
      setOpen(true);
    }

    menu?.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('[role="menuitem"]');
      if (!item) return;
      setMenu(false);
      key?.focus();
      if (item.hasAttribute('data-gf-menu-toggle')) {
        setOpen(!isOpen);
      } else {
        root.dispatchEvent(new CustomEvent('gf:menuitem', {
          bubbles: true,
          detail: { label: item.dataset.gfMenuLabel, folder: label },
        }));
      }
    });

    menu?.addEventListener('keydown', (e) => {
      const items = Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]'));
      const at = items.indexOf(document.activeElement as HTMLElement);
      const go = (i: number) => {
        e.preventDefault();
        items[(i + items.length) % items.length]?.focus();
      };
      if (e.key === 'ArrowDown') go(at + 1);
      else if (e.key === 'ArrowUp') go(at - 1);
      else if (e.key === 'Home') go(0);
      else if (e.key === 'End') go(items.length - 1);
      else if (e.key === 'Tab') setMenu(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (menuOpen) { setMenu(false); key?.focus(); }
      else if (isOpen) { setOpen(false); hit?.focus(); }
    });

    document.addEventListener('pointerdown', (e) => {
      const t = e.target as Node;
      if (menuOpen && !menu?.contains(t) && !key?.contains(t)) setMenu(false);
      if (isOpen && !menuOpen && !root.contains(t)) setOpen(false);
    });
  }

  const boot = () => {
    document.querySelectorAll<HTMLElement>('.gf-root').forEach(initFolder);
    paintArtworks(document);
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>

<style is:global>
  .gf-root {
    --gf-px: 0;
    --gf-py: 0;
    --gf-ease: cubic-bezier(.2, .8, .2, 1);
    --gf-spring: cubic-bezier(.34, 1.36, .5, 1);
    --gf-hinge: 0deg;
    --gf-lift: 42px;
    --gf-spread: 0px;
    --gf-fan: 0deg;
    --gf-stack: 15px;
    --gf-ink: #141416;
    --gf-ink-soft: rgba(20, 20, 22, .55);
    position: relative;
    display: inline-block;
    flex: none;
    vertical-align: top;
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
    isolation: isolate;
  }
  .gf-root[data-tone="dark"] { --gf-ink: #f5f5f7; --gf-ink-soft: rgba(245, 245, 247, .58); }
  .gf-root:hover, .gf-root:focus-within { --gf-hinge: -11deg; --gf-lift: -34px; --gf-spread: 8px; --gf-fan: 1.4deg; --gf-stack: 10px; }
  .gf-root[data-open] { --gf-hinge: -24deg; --gf-lift: -96px; --gf-spread: 40px; --gf-fan: 5deg; --gf-stack: 30px; }

  .gf-stage { position: absolute; left: 0; top: 0; width: 340px; height: 272px; transform-origin: 0 0; }
  .gf-tilt {
    position: absolute;
    inset: 0;
    transform: perspective(1400px) rotateX(calc(var(--gf-py) * -3deg)) rotateY(calc(var(--gf-px) * 4deg));
    transition: transform .9s var(--gf-ease);
  }

  .gf-shadow {
    position: absolute;
    left: 18px; right: 18px; bottom: -6px; height: 60px;
    border-radius: 40px;
    background: rgba(16, 18, 24, .34);
    filter: blur(22px);
    transform: translateX(calc(var(--gf-px) * -8px));
    transition: transform .9s var(--gf-ease), opacity .9s var(--gf-ease);
  }
  .gf-root[data-tone="dark"] .gf-shadow { background: rgba(0, 0, 0, .62); }

  .gf-back {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(180deg, #f3f3f4 0%, #e3e3e6 100%);
  }
  .gf-root[data-tone="dark"] .gf-back { background: linear-gradient(180deg, #2a2a2e 0%, #121214 100%); }
  .gf-art {
    position: absolute;
    left: -12px; top: -12px;
    max-width: none;
    object-fit: cover;
    transform: translate(calc(var(--gf-px) * -7px), calc(var(--gf-py) * -6px)) scale(1.02);
    transition: transform 1.1s var(--gf-ease), opacity 1.2s var(--gf-ease), filter 1.2s var(--gf-ease);
  }
  .gf-photo { z-index: 1; }
  canvas.gf-art { opacity: 0; filter: blur(14px) saturate(.6); }
  canvas.gf-art[data-ready] { opacity: 1; filter: none; }
  .gf-back-sheen {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .22) 0%, rgba(255, 255, 255, 0) 22%),
      radial-gradient(120% 80% at 80% 0%, rgba(255, 255, 255, .16), rgba(255, 255, 255, 0) 60%);
    pointer-events: none;
  }

  .gf-rim { position: absolute; left: 0; top: 0; max-width: none; overflow: visible; pointer-events: none; fill: none; }
  .gf-back-rim { width: 340px; height: 272px; }
  .gf-back-rim path { stroke: rgba(255, 255, 255, .45); stroke-width: 1; }
  .gf-root[data-tone="dark"] .gf-back-rim path { stroke: rgba(255, 255, 255, .16); }

  /* ---- files -------------------------------------------------------------- */
  .gf-files {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    clip-path: inset(-400px -400px 10px -400px);
  }
  .gf-sheet-slot { display: contents; }
  .gf-sheet {
    all: unset;
    box-sizing: border-box;
    position: absolute;
    left: 34px; top: 96px;
    width: 272px; height: 184px;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    pointer-events: auto;
    background: linear-gradient(180deg, #ffffff 0%, #f2f2f0 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9), 0 0 0 .5px rgba(0, 0, 0, .1), 0 10px 26px -8px rgba(10, 12, 20, .28);
    transform-origin: 50% 100%;
    transform:
      translate(calc(var(--gf-jx) + var(--gf-slot) * var(--gf-spread)), calc(var(--gf-lift) + var(--gf-depth) * var(--gf-stack) * -1))
      rotate(calc(var(--gf-jr) + var(--gf-slot) * var(--gf-fan)));
    transition:
      transform .75s var(--gf-spring) calc(var(--gf-depth) * 40ms),
      box-shadow .4s var(--gf-ease),
      translate .9s var(--gf-ease),
      opacity .9s var(--gf-ease);
  }
  .gf-root[data-tone="dark"] .gf-sheet {
    background: linear-gradient(180deg, #2c2c30 0%, #1c1c1f 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .14), 0 0 0 .5px rgba(255, 255, 255, .08), 0 12px 28px -8px rgba(0, 0, 0, .7);
  }
  .gf-sheet--art { background: #1a1a1d; }
  .gf-root[data-open] .gf-sheet:hover,
  .gf-root[data-open] .gf-sheet:focus-visible {
    transform:
      translate(calc(var(--gf-jx) + var(--gf-slot) * var(--gf-spread)), calc(var(--gf-lift) + var(--gf-depth) * var(--gf-stack) * -1 - 18px))
      rotate(calc(var(--gf-slot) * var(--gf-fan) * .6));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9), 0 0 0 .5px rgba(0, 0, 0, .1), 0 22px 40px -12px rgba(10, 12, 20, .42);
