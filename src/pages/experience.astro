---
// Experience page - Stats, timeline, roles with scroll animations

import PageShell from '@/layouts/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import ScrollContent from '@/components/ScrollContent.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import { stats, timeline, roles } from '@/data/profile';
---

<PageShell title="Experience — Yuvaan Gulati">
  <PageHeader
    eyebrow="experience"
    title="Competition, robotics, teaching, and technical growth."
    body="A structured view of the work behind the portfolio: competitions, team roles, mentoring, coursework, and applied STEM projects."
  />

  <!-- Stats Section -->
  <ScrollContent class="pb-16">
    <div data-scroll-reveal data-direction="up" data-distance="40" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow mb-10">metrics/</p>
    </div>

    <div
      data-stagger-container
      data-stagger="0.08"
      data-delay-children="0.15"
      class="mx-auto grid max-w-7xl grid-cols-1 gap-3 px-5 sm:grid-cols-2 sm:px-8 lg:grid-cols-3"
    >
      {stats.map((stat, index) => (
        <div
          data-od-id={`stat-${stat.value.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="group relative min-h-[170px] rounded-xl border border-mistral-border bg-white p-5 transition-colors duration-300 hover:border-mistral-text"
          data-scroll-reveal
          data-direction="up"
          data-distance="30"
          data-delay={0.1 + index * 0.03}
        >
          <p class="font-serif text-4xl leading-none tracking-tight text-mistral-text transition-transform duration-300 group-hover:scale-[1.02]">{stat.value}</p>
          <p class="mt-4 text-sm leading-6 text-mistral-textMuted">{stat.label}</p>
        </div>
      ))}
    </div>
  </ScrollContent>

  <SectionDivider />

  <!-- Timeline Section -->
  <ScrollContent class="pb-16">
    <div data-scroll-reveal data-direction="up" data-distance="40" data-delay="0.1" class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-5 sm:px-8 lg:grid-cols-[0.38fr_1fr]">
      <div>
        <p class="eyebrow">timeline/</p>
        <h2 class="mt-5 heading-3">recent_work</h2>
      </div>
      <div class="relative">
        {/* Timeline line */}
        <div class="absolute bottom-0 left-4 top-0 w-px bg-mistral-border" aria-hidden="true" />

        <div data-stagger-container data-stagger="0.08" data-delay-children="0.15" class="border-l border-mistral-border pl-8">
          {timeline.map((item, index) => (
            <div
              class="relative border-b border-mistral-border pb-8 last:border-b-0"
              data-scroll-reveal
              data-direction="right"
              data-distance="30"
              data-delay={0.15 + index * 0.03}
            >
              <span class="absolute -left-[10px] top-4 h-3 w-3 rounded-full border-4 border-mistral-bg bg-mistral-text" aria-hidden="true" />
              <p class="font-mono text-sm text-mistral-textMuted">/{item.year}</p>
              <h3 class="mt-2 text-2xl font-medium tracking-tight text-mistral-text">{item.title}</h3>
              <p class="mt-3 max-w-2xl leading-7 text-mistral-textMuted">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </ScrollContent>

  <SectionDivider />

  <!-- Roles Section -->
  <ScrollContent class="pb-20">
    <div data-scroll-reveal data-direction="up" data-distance="40" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow mb-8">roles[]</p>
    </div>

    <div data-stagger-container data-stagger="0.06" data-delay-children="0.15" class="mx-auto grid max-w-7xl grid-cols-1 gap-3 px-5 sm:px-8 lg:grid-cols-2">
      {roles.map((role, index) => (
        <div
          data-od-id={`role-${index + 1}`}
          class="rounded-xl border border-mistral-border bg-white p-5 text-lg text-mistral-textSecondary transition-colors duration-300 hover:border-mistral-text"
          data-scroll-reveal
          data-direction="up"
          data-distance="20"
          data-delay={0.15 + index * 0.02}
        >
          <p class="font-medium text-mistral-text">{role.title}</p>
          <p class="mt-1 text-mistral-textMuted">{role.description}</p>
        </div>
      ))}
    </div>
  </ScrollContent>
</PageShell>
