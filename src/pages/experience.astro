---
// Experience — metrics, timeline, and roles.

import PageShell from '@/layouts/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import { stats, timeline, roles } from '@/data/profile';

const pad = (value: number) => String(value).padStart(2, '0');
---

<PageShell
  title="Experience — Yuvaan Gulati"
  description="Competitions, robotics, teaching, and technical growth — the record behind the portfolio."
>
  <PageHeader
    eyebrow="Experience / record"
    number="03"
    title="Competition, robotics, teaching, and technical growth."
    body="A structured view of the work behind the portfolio: competitions, team roles, mentoring, coursework, and applied STEM projects."
  />

  <!-- 01 — Metrics -->
  <section class="section metrics" aria-labelledby="metrics-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="metrics-title" class="h2 sec-head__title">By the numbers</h2>
        <p class="sec-head__meta">01 / Metrics<br />Eight results</p>
      </div>

      <div class="metrics__grid">
        {stats.map((stat, index) => (
          <article class="metric" data-od-id={`stat-${stat.value.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
            <p class="mono metric__num">{pad(index + 1)}</p>
            <p class="metric__value">{stat.value}</p>
            <p class="metric__label">{stat.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 — Timeline -->
  <section class="section timeline" aria-labelledby="timeline-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="timeline-title" class="h2 sec-head__title">Recent work</h2>
        <p class="sec-head__meta">02 / Timeline<br />Eight entries, 2026</p>
      </div>

      <div class="timeline__list">
        {timeline.map((item, index) => (
          <article class="timeline__item">
            <div class="timeline__side">
              <span class="mono">{pad(index + 1)}</span>
              <span class="mono timeline__year">/{item.year}</span>
            </div>
            <div class="timeline__content">
              <h3 class="h4 timeline__title">{item.title}</h3>
              <p class="body timeline__body">{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 — Roles -->
  <section class="section roles" aria-labelledby="roles-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="roles-title" class="h2 sec-head__title">Roles</h2>
        <p class="sec-head__meta">03 / Responsibilities<br />Nine positions</p>
      </div>

      <div class="roles__grid">
        {roles.map((role, index) => (
          <article class="role" data-od-id={`role-${index + 1}`}>
            <span class="mono role__num">{pad(index + 1)}</span>
            <div>
              <h3 class="role__title">{role.title}</h3>
              <p class="body role__body">{role.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</PageShell>

<style>
  /* --------------------------------------------------------------- Metrics */

  .metrics__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .metric {
    display: flex;
    flex-direction: column;
    min-height: 12.5rem;
    padding: 1rem clamp(1rem, 2vw, 1.75rem) 1.5rem 0;
    border-top: 1px solid var(--ink);
    border-right: 1px solid var(--rule);
  }

  .metric:not(:nth-child(4n + 1)) {
    padding-left: clamp(1rem, 2vw, 1.75rem);
  }

  .metric:nth-child(4n) {
    border-right: 0;
    padding-right: 0;
  }

  .metric:nth-child(n + 5) {
    border-top-color: var(--rule);
  }

  .metric__num {
    margin: 0 0 1.5rem;
  }

  .metric__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.6vw, 3.6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .metric__label {
    margin: auto 0 0;
    padding-top: 1.5rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* -------------------------------------------------------------- Timeline */

  .timeline {
    border-top: 1px solid var(--rule);
  }

  .timeline__list {
    display: flex;
    flex-direction: column;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    padding-block: clamp(1.5rem, 2.5vw, 2.25rem);
    border-top: 1px solid var(--rule);
  }

  .timeline__item:first-child {
    border-top-color: var(--ink);
  }

  .timeline__side {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.35rem;
  }

  .timeline__year {
    color: var(--ink);
    font-size: 0.56rem;
  }

  .timeline__title {
    margin: 0;
    max-width: 24ch;
  }

  .timeline__body {
    margin: 0.7rem 0 0;
    max-width: 66ch;
    font-size: 0.96rem;
  }

  /* ----------------------------------------------------------------- Roles */

  .roles {
    border-top: 1px solid var(--rule);
  }

  .roles__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(2rem, 5vw, 4.5rem);
  }

  .role {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .role:nth-child(-n + 2) {
    border-top-color: var(--ink);
  }

  .role__num {
    margin: 0.2rem 0 0;
    color: var(--muted);
  }

  .role__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .role__body {
    margin: 0.45rem 0 0;
    max-width: 44ch;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 1023px) {
    .metrics__grid {
      grid-template-columns: 1fr 1fr;
    }

    .metric:nth-child(4n) {
      border-right: 1px solid var(--rule);
      padding-right: clamp(1rem, 2vw, 1.75rem);
    }

    .metric:nth-child(2n) {
      border-right: 0;
      padding-right: 0;
    }

    .metric:nth-child(n + 3) {
      border-top-color: var(--rule);
    }
  }

  @media (max-width: 720px) {
    .timeline__item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .timeline__side {
      flex-direction: row;
      justify-content: space-between;
      gap: 1rem;
      padding-top: 0;
    }

    .roles__grid {
      grid-template-columns: 1fr;
    }

    .role:nth-child(2) {
      border-top-color: var(--rule);
    }
  }

  @media (max-width: 520px) {
    .metrics__grid {
      grid-template-columns: 1fr;
    }

    .metric,
    .metric:not(:nth-child(4n + 1)) {
      min-height: 0;
      padding: 1rem 0 1.35rem;
      border-right: 0;
    }

    .metric + .metric {
      border-top-color: var(--rule);
    }

    .metric__label {
      padding-top: 0.75rem;
    }
  }
</style>
