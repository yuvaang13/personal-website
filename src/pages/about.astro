---
// About — direction, highlights, interests, and tools.

import PageShell from '@/layouts/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import { profile, highlights, educationInterests, skills } from '@/data/profile';

const iconPaths: Record<string, string> = {
  trophy:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4ZM7 5H4v2a3 3 0 0 0 3 3M17 5h3v2a3 3 0 0 1-3 3" />',
  brain:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9.5 3.5A3 3 0 0 0 6.5 6.5a3 3 0 0 0-1.8 5.4A3 3 0 0 0 6.5 17a3 3 0 0 0 3 3.5M14.5 3.5a3 3 0 0 1 3 3 3 3 0 0 1 1.8 5.4A3 3 0 0 1 17.5 17a3 3 0 0 1-3 3.5M12 4v16" />',
  code2:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="m9 8-4 4 4 4M15 8l4 4-4 4" />',
  users:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />',
  microscope:
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M6 18h8M3 22h18M14 22a7 7 0 1 0 0-14h-1M9 14h2M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3" />',
  'graduation-cap':
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="m22 10-10-5L2 10l10 5 10-5ZM6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5" />',
};

const skillGroups = skills.reduce<Array<{ category: string; items: string[] }>>((groups, skill) => {
  const category = skill.category ?? 'Other';
  const existing = groups.find((group) => group.category === category);
  if (existing) {
    existing.items.push(skill.name);
  } else {
    groups.push({ category, items: [skill.name] });
  }
  return groups;
}, []);

const pad = (value: number) => String(value).padStart(2, '0');
---

<PageShell
  title="About — Yuvaan Gulati"
  description="A math-heavy builder with a practical AI streak. Student developer in Greater Boston working across AI, robotics, and STEM education."
>
  <PageHeader
    eyebrow="About / profile"
    number="02"
    title="A math-heavy builder with a practical AI streak."
    body={profile.shortIntro}
  />

  <!-- 01 — Direction -->
  <section class="section direction" aria-labelledby="direction-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="direction-title" class="h2 sec-head__title">
          I like projects where software meets rigorous thinking.
        </h2>
        <p class="sec-head__meta">01 / Direction<br />Applied, not abstract</p>
      </div>

      <div class="direction__grid">
        <p class="lead">
          My work sits between math, science, and technology. I compete in math and science
          events, build AI applications, experiment with machine learning models, and mentor
          younger students in STEM.
        </p>
        <p class="lead">
          I am especially interested in computer science, electrical engineering, AI/ML,
          robotics, computer vision in healthcare, and personalized tutoring systems. Long
          term, I want to build tools that make high-quality learning and problem solving
          more accessible.
        </p>
      </div>
    </div>
  </section>

  <!-- 02 — Highlights -->
  <section class="section highlights" aria-labelledby="highlights-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="highlights-title" class="h2 sec-head__title">Highlights</h2>
        <p class="sec-head__meta">02 / Six areas<br />Competition to classroom</p>
      </div>

      <div class="highlights__grid">
        {highlights.map((item, index) => (
          <article class="highlight" data-od-id={`highlight-${item.label}`}>
            <div class="highlight__top">
              <span class="mono">{pad(index + 1)}</span>
              <svg
                class="highlight__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
              >
                <Fragment set:html={iconPaths[item.icon] ?? iconPaths.trophy} />
              </svg>
            </div>
            <p class="mono highlight__label">{item.label}</p>
            <h3 class="h4 highlight__title">{item.title}</h3>
            <p class="body highlight__body">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 — Interests -->
  <section class="section interests" aria-labelledby="interests-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="interests-title" class="h2 sec-head__title">Interests</h2>
        <p class="sec-head__meta">03 / Long-term direction<br />Six fields</p>
      </div>

      <div class="interests__grid">
        {educationInterests.map((interest, index) => (
          <article class="interest">
            <span class="mono interest__num">{pad(index + 1)}</span>
            <div>
              <h3 class="h4 interest__title">{interest.title}</h3>
              <p class="body interest__body">{interest.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 — Tools -->
  <section class="section tools" aria-labelledby="tools-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="tools-title" class="h2 sec-head__title">Tools and skills</h2>
        <p class="sec-head__meta">04 / Working set<br />{skills.length} tools</p>
      </div>

      <div class="tools__list">
        {skillGroups.map((group) => (
          <div class="tool-group">
            <p class="mono tool-group__label">{group.category}</p>
            <ul class="tool-group__list">
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageShell>

<style>
  /* ------------------------------------------------------------- Direction */

  .direction__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .direction__grid p {
    margin: 0;
    max-width: 46ch;
  }

  /* ------------------------------------------------------------ Highlights */

  .highlights {
    border-top: 1px solid var(--rule);
  }

  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .highlight {
    display: flex;
    flex-direction: column;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .highlight__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .highlight__icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--ink);
    transition: transform 300ms var(--ease-out);
  }

  .highlight:hover .highlight__icon {
    transform: translateY(-2px);
  }

  .highlight__label {
    margin: 1.5rem 0 0;
  }

  .highlight__title {
    margin: 0.6rem 0 0;
    max-width: 18ch;
  }

  .highlight__body {
    margin: 0.85rem 0 0;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  /* ------------------------------------------------------------- Interests */

  .interests {
    border-top: 1px solid var(--rule);
  }

  .interests__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(2rem, 6vw, 5rem);
  }

  .interest {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--rule);
  }

  .interest:nth-child(-n + 2) {
    border-top-color: var(--ink);
  }

  .interest__num {
    margin: 0.4rem 0 0;
    color: var(--muted);
  }

  .interest__title {
    margin: 0;
  }

  .interest__body {
    margin: 0.5rem 0 0;
    font-size: 0.94rem;
    line-height: 1.6;
    max-width: 44ch;
  }

  /* ----------------------------------------------------------------- Tools */

  .tools {
    border-top: 1px solid var(--rule);
  }

  .tools__list {
    display: flex;
    flex-direction: column;
  }

  .tool-group {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .tool-group:first-child {
    border-top-color: var(--ink);
  }

  .tool-group__label {
    margin: 0;
    padding-top: 0.4rem;
  }

  .tool-group__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .highlights__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 720px) {
    .direction__grid {
      grid-template-columns: 1fr;
    }

    .interests__grid {
      grid-template-columns: 1fr;
    }

    .interest:nth-child(2) {
      border-top-color: var(--rule);
    }

    .highlights__grid {
      grid-template-columns: 1fr;
    }

    .tool-group {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .tool-group__label {
      padding-top: 0;
    }
  }
</style>
