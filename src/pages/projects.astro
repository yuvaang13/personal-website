---
// Projects page - Project cards with images, detailed views, scroll animations

import PageShell from '@/layouts/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import ScrollContent from '@/components/ScrollContent.astro';
import { projects } from '@/data/profile';
---

<PageShell title="Projects — Yuvaan Gulati">
  <PageHeader
    eyebrow="projects/"
    title="AI tools, apps, ML experiments, and STEM systems."
    body="A fuller look at the things I am building: from tutoring platforms and health-focused computer vision concepts to productivity software and machine learning experiments."
  />

  <!-- Featured Projects -->
  <ScrollContent class="pb-36">
    <div data-scroll-reveal data-direction="up" data-distance="60" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow mb-14">featured_work</p>
    </div>

    <div data-stagger-container data-stagger="0.12" data-delay-children="0.15" class="mx-auto flex max-w-7xl flex-col gap-12 px-5 sm:px-8">
      {projects
        .filter(p => p.featured)
        .sort((a, b) => a.impactOrder - b.impactOrder)
        .map((project, index) => {
          const hasImage = !!project.image;

          return (
            <article
              data-od-id={`project-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
              class={`group relative overflow-hidden rounded-xl border border-mistral-border bg-white transition-colors duration-300 hover:border-mistral-text ${
                hasImage ? "md:grid md:grid-cols-[1fr_1fr]" : ""
              }`}
              data-scroll-reveal
              data-direction="up"
              data-distance="40"
              data-delay={0.1 + index * 0.05}
            >
              {/* Image/Visual Side */}
              {hasImage && (
                <div class="relative h-72 overflow-hidden bg-mistral-bgElevated md:h-auto md:min-h-[420px]">
                  <img
                    src={project.image}
                    alt={`${project.title} preview`}
                    class="h-full w-full object-contain transition-transform duration-700 group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white/50 to-transparent" />
                  <div class="absolute bottom-5 left-5">
                    <span class="tag-filled">{project.type}</span>
                  </div>
                </div>
              )}

              {/* Content Side */}
              <div class={`relative p-6 md:p-8 ${hasImage ? "" : "min-h-[420px]"}`}>
                <div class="flex h-full flex-col justify-between gap-10">
                  <div>
                    {!hasImage && (
                      <div class="mb-6 flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-[0.22em] text-mistral-textMuted">
                        <span>{project.type}</span>
                        <span class="h-1 w-1 rounded-full bg-mistral-text" />
                        <span>{project.status}</span>
                      </div>
                    )}
                    <h2 class="heading-3">{project.title}</h2>
                    <p class="mt-5 body-lg">{project.summary}</p>
                    <p class="mt-5 leading-7 text-mistral-textMuted">{project.details}</p>
                  </div>

                  <div>
                    <div class="flex flex-wrap gap-2">
                      {project.tags.map((tag) => (
                        <span key={tag} class="tag">{tag}</span>
                      ))}
                    </div>
                    {project.links ? (
                      <div class="mt-6 flex flex-wrap gap-3">
                        {project.links.map((link) => (
                          <a
                            key={link.href}
                            href={link.href}
                            target="_blank"
                            rel="noreferrer"
                            class="link-external"
                          >
                            {link.label}
                            {link.href.includes("github") ? (
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                              </svg>
                            ) : (
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                          </a>
                        ))}
                      </div>
                    ) : null}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
    </div>
  </ScrollContent>

  <!-- Other Projects -->
  <ScrollContent class="pb-36">
    <div data-scroll-reveal data-direction="up" data-distance="60" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow mb-14">other_work</p>
    </div>

    <div data-stagger-container data-stagger="0.1" data-delay-children="0.15" class="mx-auto flex max-w-7xl flex-col gap-8 px-5 sm:px-8">
      {projects
        .filter(p => !p.featured)
        .sort((a, b) => a.impactOrder - b.impactOrder)
        .map((project, index) => {
          const hasImage = !!project.image;

          return (
            <article
              data-od-id={`project-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
              class={`group relative overflow-hidden rounded-xl border border-mistral-border bg-white p-6 transition-colors duration-300 hover:border-mistral-text md:p-8 ${
                hasImage ? "md:grid md:grid-cols-[1fr_1fr] md:gap-8" : ""
              }`}
              data-scroll-reveal
              data-direction="up"
              data-distance="30"
              data-delay={0.1 + index * 0.05}
            >
              {hasImage && (
                <div class="relative -m-6 mb-6 h-64 overflow-hidden bg-mistral-bgElevated md:m-0 md:min-h-[350px] md:rounded-lg">
                  <img
                    src={project.image}
                    alt={`${project.title} preview`}
                    class="h-full w-full object-contain transition-transform duration-700 group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white/50 to-transparent" />
                  <div class="absolute bottom-4 left-4">
                    <span class="tag-filled">{project.type}</span>
                  </div>
                </div>
              )}

              <div class={`relative ${hasImage ? "md:p-0" : ""}`}>
                <div class="flex h-full flex-col justify-between gap-8">
                  <div>
                    {!hasImage && (
                      <div class="mb-4 flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-[0.22em] text-mistral-textMuted">
                        <span>{project.type}</span>
                        <span class="h-1 w-1 rounded-full bg-mistral-text" />
                        <span>{project.status}</span>
                      </div>
                    )}
                    <h3 class="text-2xl font-medium tracking-tight text-mistral-text">{project.title}</h3>
                    <p class="mt-4 body-md">{project.summary}</p>
                    <p class="mt-4 leading-7 text-mistral-textMuted">{project.details}</p>
                  </div>

                  <div>
                    <div class="flex flex-wrap gap-2">
                      {project.tags.map((tag) => (
                        <span key={tag} class="tag">{tag}</span>
                      ))}
                    </div>
                    {project.links ? (
                      <div class="mt-4 flex flex-wrap gap-3">
                        {project.links.map((link) => (
                          <a
                            key={link.href}
                            href={link.href}
                            target="_blank"
                            rel="noreferrer"
                            class="link-external"
                          >
                            {link.label}
                            {link.href.includes("github") ? (
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                              </svg>
                            ) : (
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                          </a>
                        ))}
                      </div>
                    ) : null}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
    </div>
  </ScrollContent>

  <!-- Bottom CTA -->
  <ScrollContent class="pb-28">
    <div data-scroll-reveal data-direction="up" data-distance="40" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8 text-center">
      <p class="eyebrow mb-6">more_coming/</p>
      <h2 class="heading-3 mb-4">Always building. Always learning.</h2>
      <p class="mx-auto mb-8 max-w-2xl text-mistral-textMuted">
        New experiments in AI, robotics, and education tools are always in progress.
        Check GitHub for the latest commits and works-in-progress.
      </p>
      <a
        data-od-id="cta-github"
        href="https://github.com/yuvaang13"
        target="_blank"
        rel="noreferrer"
        class="btn-primary"
      >
        View on GitHub
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 19l7-7m0 0l-7-7m7 7H3" />
        </svg>
      </a>
    </div>
  </ScrollContent>
</PageShell>
