---
// Projects page - Project cards with images, detailed views, scroll animations

import PageShell from '@/layouts/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import ScrollContent from '@/components/ScrollContent.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import { projects } from '@/data/profile';
---

<PageShell title="Projects — Yuvaan Gulati" backgroundVariant="sparse">
  <PageHeader
    eyebrow="projects/"
    title="AI tools, apps, ML experiments, and STEM systems."
    body="A fuller look at the things I am building: from tutoring platforms and health-focused computer vision concepts to productivity software and machine learning experiments."
  />

  <!-- Featured Projects -->
  <ScrollContent class="pb-20">
    <div data-scroll-reveal data-direction="up" data-distance="60" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow mb-12">featured_work</p>
    </div>

    <div data-stagger-container data-stagger="0.12" data-delay-children="0.15" class="mx-auto max-w-7xl px-5 sm:px-8">
      {projects
        .filter(p => p.featured)
        .sort((a, b) => a.impactOrder - b.impactOrder)
        .map((project, index) => {
          const hasImage = !!project.image;

          return (
            <article
              class={`group relative overflow-hidden border border-zinc-800 bg-black/50 backdrop-blur-sm transition-all duration-500 hover:border-zinc-700 hover:bg-white/[0.02] ${
                hasImage ? "md:grid md:grid-cols-[1fr_1fr]" : ""
              }`}
              data-scroll-reveal
              data-direction="up"
              data-distance="40"
              data-delay={0.1 + index * 0.05}
            >
              {/* Image/Visual Side */}
              {hasImage && (
                <div class="relative h-72 md:h-auto md:min-h-[420px] overflow-hidden border-b border-zinc-800 md:border-b-0 md:border-r">
                  <img
                    src={project.image}
                    alt={`${project.title} preview`}
                    class="object-cover w-full h-full transition-all duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  {/* Gradient overlay */}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none" />
                  {/* Project type badge */}
                  <div class="absolute bottom-6 left-6 right-6 md:left-8 md:bottom-8">
                    <span class="tag-filled">{project.type}</span>
                  </div>
                </div>
              )}

              {/* Content Side */}
              <div class={`relative p-6 md:p-8 ${hasImage ? "" : "min-h-[420px]"}`}>
                <div class="flex h-full flex-col justify-between gap-10">
                  <div>
                    {!hasImage && (
                      <div class="mb-6 flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.22em] text-zinc-600">
                        <span>{project.type}</span>
                        <span class="h-1 w-1 rounded-full bg-zinc-700" />
                        <span>{project.status}</span>
                      </div>
                    )}
                    <h2 class="heading-3">{project.title}</h2>
                    <p class="mt-5 body-lg">{project.summary}</p>
                    <p class="mt-5 leading-7 text-zinc-500">{project.details}</p>
                  </div>

                  <div>
                    <div class="flex flex-wrap gap-2">
                      {project.tags.map((tag) => (
                        <span key={tag} class="tag">{tag}</span>
                      ))}
                    </div>
                    {project.links ? (
                      <div class="mt-6 flex flex-wrap gap-3">
                        {project.links.map((link) => (
                          <a
                            key={link.href}
                            href={link.href}
                            target="_blank"
                            rel="noreferrer"
                            class="link-external"
                          >
                            {link.label}
                            {link.href.includes("github") ? (
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                              </svg>
                            ) : (
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                          </a>
                        ))}
                      </div>
                    ) : null}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
    </div>
  </ScrollContent>

  <!-- Other Projects -->
  <ScrollContent class="pb-20">
    <div data-scroll-reveal data-direction="up" data-distance="60" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow mb-12">other_work</p>
    </div>

    <div data-stagger-container data-stagger="0.1" data-delay-children="0.15" class="mx-auto max-w-7xl px-5 sm:px-8">
      {projects
        .filter(p => !p.featured)
        .sort((a, b) => a.impactOrder - b.impactOrder)
        .map((project, index) => {
          const hasImage = !!project.image;

          return (
            <article
              class={`group relative overflow-hidden border border-zinc-800 bg-black/50 backdrop-blur-sm p-6 md:p-8 transition-all duration-500 hover:border-zinc-700 hover:bg-white/[0.02] ${
                hasImage ? "md:grid md:grid-cols-[1fr_1fr]" : ""
              }`}
              data-scroll-reveal
              data-direction="up"
              data-distance="30"
              data-delay={0.1 + index * 0.05}
            >
              {hasImage && (
                <div class="relative h-64 md:h-auto md:min-h-[350px] overflow-hidden border-b border-zinc-800 md:border-b-0 md:border-r -m-6 md:m-0 md:p-0 mb-6 md:mb-0">
                  <img
                    src={project.image}
                    alt={`${project.title} preview`}
                    class="object-cover w-full h-full transition-all duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none" />
                  <div class="absolute bottom-4 left-4 right-4 md:left-6 md:bottom-6">
                    <span class="tag-filled">{project.type}</span>
                  </div>
                </div>
              )}

              <div class={`relative ${hasImage ? "p-0 md:p-8" : ""}`}>
                <div class="flex h-full flex-col justify-between gap-8">
                  <div>
                    {!hasImage && (
                      <div class="mb-4 flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.22em] text-zinc-600">
                        <span>{project.type}</span>
                        <span class="h-1 w-1 rounded-full bg-zinc-700" />
                        <span>{project.status}</span>
                      </div>
                    )}
                    <h3 class="text-2xl font-medium tracking-tight text-white">{project.title}</h3>
                    <p class="mt-4 body-md">{project.summary}</p>
                    <p class="mt-4 leading-7 text-zinc-500">{project.details}</p>
                  </div>

                  <div>
                    <div class="flex flex-wrap gap-2">
                      {project.tags.map((tag) => (
                        <span key={tag} class="tag">{tag}</span>
                      ))}
                    </div>
                    {project.links ? (
                      <div class="mt-4 flex flex-wrap gap-3">
                        {project.links.map((link) => (
                          <a
                            key={link.href}
                            href={link.href}
                            target="_blank"
                            rel="noreferrer"
                            class="link-external"
                          >
                            {link.label}
                            {link.href.includes("github") ? (
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                              </svg>
                            ) : (
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            )}
                          </a>
                        ))}
                      </div>
                    ) : null}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
    </div>
  </ScrollContent>

  <!-- Bottom CTA -->
  <ScrollContent class="pb-20">
    <SectionDivider />
    <div data-scroll-reveal data-direction="up" data-distance="40" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8 text-center">
      <p class="eyebrow mb-6">more_coming/</p>
      <h2 class="heading-3 mb-4">Always building. Always learning.</h2>
      <p class="max-w-2xl mx-auto text-zinc-400 mb-8">
        New experiments in AI, robotics, and education tools are always in progress.
        Check GitHub for the latest commits and works-in-progress.
      </p>
      <a
        href="https://github.com/yuvaang13"
        target="_blank"
        rel="noreferrer"
        class="btn-secondary"
      >
        View on GitHub
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 19l7-7m0 0l-7-7m7 7H3" />
        </svg>
      </a>
    </div>
  </ScrollContent>
</PageShell>