---
// Contact page - Contact links with animations and additional info

import PageShell from '@/layouts/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import ScrollContent from '@/components/ScrollContent.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import { profile, contactLinks, contactNotes } from '@/data/profile';

const iconPaths = {
  mail: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
  github: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />',
  'map-pin': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />',
};
---

<PageShell title="Contact — Yuvaan Gulati">
  <PageHeader
    eyebrow="contact"
    title="Projects, STEM ideas, robotics, or AI work."
    body="The best way to reach me is email. You can also find my code and current experiments on GitHub."
  />

  <ScrollContent class="pb-16">
    <div data-scroll-reveal data-direction="up" data-distance="40" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow mb-10">channels/</p>
    </div>

    <div
      data-stagger-container
      data-stagger="0.1"
      data-delay-children="0.15"
      class="mx-auto grid max-w-7xl grid-cols-1 gap-3 px-5 md:grid-cols-3 sm:px-8"
    >
      {contactLinks.map((item, index) => {
        const iconPath = iconPaths[item.icon] || iconPaths.mail;

        return (
          <div
            data-od-id={`contact-${item.label.toLowerCase()}`}
            class="group relative min-h-[260px] rounded-xl border border-mistral-border bg-white transition-colors duration-300 hover:border-mistral-text"
            data-scroll-reveal
            data-direction="up"
            data-distance="30"
            data-delay={0.1 + index * 0.05}
          >
            <a
              href={item.href}
              target={item.href.startsWith("http") ? "_blank" : undefined}
              rel={item.href.startsWith("http") ? "noreferrer" : undefined}
              class="focus-ring flex h-full flex-col justify-between gap-10 p-6"
            >
              <div>
                <svg class="h-7 w-7 text-mistral-text transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={iconPath} />
                <p class="mt-6 eyebrow">{item.label}</p>
              </div>
              <div>
                <p class="break-words text-xl text-mistral-textSecondary transition-colors group-hover:text-mistral-text">{item.value}</p>
                <p class="mt-3 text-sm text-mistral-textMuted">{item.description}</p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-mistral-text transition-transform group-hover:translate-x-1">
                  open
                  <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 19l7-7m0 0l-7-7m7 7H3" />
                  </svg>
                </span>
              </div>
            </a>
          </div>
        );
      })}
    </div>
  </ScrollContent>

  <SectionDivider />

  <!-- Additional Contact Info -->
  <ScrollContent class="pb-20">
    <div data-scroll-reveal data-direction="up" data-distance="40" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow mb-8">notes/</p>
      <div class="grid gap-3 md:grid-cols-3">
        {contactNotes.map((note, index) => (
          <div
            data-od-id={`note-${note.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            class="rounded-xl border border-mistral-border bg-white p-6"
            data-scroll-reveal
            data-direction="up"
            data-distance="30"
            data-delay={0.15 + index * 0.05}
          >
            <h3 class="mb-2 font-medium text-mistral-text">{note.title}</h3>
            <p class="text-mistral-textMuted">{note.body}</p>
          </div>
        ))}
      </div>
    </div>
  </ScrollContent>
</PageShell>
