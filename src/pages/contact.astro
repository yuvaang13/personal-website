---
// Contact — channels and notes.

import PageShell from '@/layouts/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import Arrow from '@/components/Arrow.astro';
import { profile, contactLinks, contactNotes } from '@/data/profile';

const pad = (value: number) => String(value).padStart(2, '0');
---

<PageShell
  title="Contact — Yuvaan Gulati"
  description="Projects, STEM ideas, robotics, or AI work — reach Yuvaan Gulati by email, GitHub, or LinkedIn."
>
  <PageHeader
    eyebrow="Contact / channels"
    number="04"
    title="Projects, STEM ideas, robotics, or AI work."
    body="The best way to reach me is email. You can also find my code and current experiments on GitHub, and connect with me on LinkedIn."
  />

  <!-- 01 — Channels -->
  <section class="section channels" aria-labelledby="channels-title">
    <div class="wrap">
      <div class="channels__head">
        <h2 id="channels-title" class="h2">Channels</h2>
        <button
          type="button"
          id="copy-email"
          data-email={profile.email}
          class="btn btn--ghost btn--small"
        >
          <span id="copy-email-label">Copy email</span>
        </button>
      </div>

      <div class="channels__list">
        {contactLinks.map((item, index) => (
          <a
            href={item.href}
            class="channel"
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
            data-od-id={`contact-${item.label.toLowerCase()}`}
          >
            <div class="channel__meta">
              <span class="mono channel__num">{pad(index + 1)}</span>
              <span class="mono channel__label">{item.label}</span>
            </div>
            <div class="channel__main">
              <span class="channel__value">{item.value}</span>
              <span class="channel__desc">{item.description}</span>
            </div>
            <Arrow size={16} class="channel__arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 — Notes -->
  <section class="section notes" aria-labelledby="notes-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="notes-title" class="h2 sec-head__title">Notes</h2>
        <p class="sec-head__meta">02 / Before you write<br />Three things to know</p>
      </div>

      <div class="notes__grid">
        {contactNotes.map((note, index) => (
          <article
            class="note"
            data-od-id={`note-${note.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          >
            <span class="mono note__num">{pad(index + 1)}</span>
            <h3 class="h4 note__title">{note.title}</h3>
            <p class="body note__body">{note.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</PageShell>

<style>
  /* -------------------------------------------------------------- Channels */

  .channels__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid var(--ink);
  }

  .channels__head h2 {
    margin: 0;
  }

  .channels__head .btn {
    min-width: 7.25rem;
    justify-content: center;
  }

  .channel {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) 1.1rem;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: start;
    padding-block: clamp(1.5rem, 2.5vw, 2.25rem);
    border-top: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 220ms ease;
  }

  .channel:hover {
    background: var(--paper-2);
  }

  .channel__meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .channel__num {
    color: var(--muted);
  }

  .channel__main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .channel__value {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 2.15rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .channel__desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 48ch;
  }

  .channel :global(svg) {
    color: var(--muted);
    transition: transform 220ms ease, color 220ms ease;
  }

  .channel:hover :global(svg) {
    transform: translate(3px, -3px);
    color: var(--ink);
  }

  /* ----------------------------------------------------------------- Notes */

  .notes {
    border-top: 1px solid var(--rule);
  }

  .notes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .note {
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .note__num {
    margin: 0;
  }

  .note__title {
    margin: 1.25rem 0 0;
  }

  .note__body {
    margin: 0.6rem 0 0;
    max-width: 36ch;
    font-size: 0.94rem;
  }

  @media (max-width: 900px) {
    .channel {
      grid-template-columns: 9rem minmax(0, 1fr) 1.1rem;
    }
  }

  @media (max-width: 720px) {
    .channel {
      grid-template-columns: minmax(0, 1fr) 1.1rem;
      gap: 0.75rem 1rem;
    }

    .channel__meta {
      grid-column: 1 / -1;
    }

    .channel__main {
      grid-column: 1;
    }

    .channel :global(svg) {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0.4rem;
    }

    .notes__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel,
    .channel__arrow {
      transition: none;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-email');
  const copyLabel = document.getElementById('copy-email-label');

  if (copyBtn instanceof HTMLButtonElement) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        if (copyLabel) copyLabel.textContent = 'Copied!';
        window.setTimeout(() => {
          if (copyLabel) copyLabel.textContent = 'Copy email';
        }, 2000);
      } catch {
        if (copyLabel) copyLabel.textContent = 'Copy failed';
        window.setTimeout(() => {
          if (copyLabel) copyLabel.textContent = 'Copy email';
        }, 2000);
      }
    });
  }
</script>
