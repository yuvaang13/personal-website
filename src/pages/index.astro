---
// Home page - Hero, featured areas, scroll-driven project showcase, CTA

import PageShell from '@/layouts/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import ScrollContent from '@/components/ScrollContent.astro';
import ScrollShowcase from '@/components/ScrollShowcase.astro';
import { profile, homeLinks } from '@/data/profile';

const featuredAreas = [
  {
    eyebrow: 'ai_ml',
    title: 'AI & machine learning',
    body: 'RAG tutoring systems, CNNs, fine-tuning, and applied ML experiments.',
    href: '/about',
  },
  {
    eyebrow: 'robotics',
    title: 'Robotics & systems',
    body: 'FTC Team 21689 — autonomy, computer vision, odometry, and driver control.',
    href: '/experience',
  },
  {
    eyebrow: 'stem_learning',
    title: 'STEM learning',
    body: 'Infinit AI, MATHCOUNTS, and volunteer teaching for younger students.',
    href: '/projects',
  },
];
---

<PageShell title={`${profile.name} — Student Developer`}>
  <!-- Hero Section -->
  <PageHeader
    eyebrow="sector 0 · home"
    title={`${profile.name}.`}
    body={profile.headline}
    number="00"
  />

  <!-- Recognition strip -->
  <ScrollContent class="pb-4 pt-6">
    <div
      data-scroll-reveal
      data-direction="up"
      data-distance="30"
      data-delay="0.08"
      class="mx-auto max-w-7xl px-5 sm:px-8"
    >
      <div class="grid grid-cols-2 gap-5 lg:grid-cols-4" data-stagger-container data-stagger="0.06" data-delay-children="0.1">
        {['Solver', '1st place', '3rd', 'FLL'].map((label, index) => {
          const sub = [
            'MIT Solve — AI For A Better World',
            'NHSEE 2026 — CS &amp; Math',
            'MATHCOUNTS Southern NH Chapter 2026',
            'Mentor — Bicentennial Elementary',
          ][index];
          return (
            <div class="rounded-xl border border-mistral-border bg-mistral-bgElevated p-6" data-scroll-reveal data-direction="up" data-distance="20" data-delay={0.08 + index * 0.05}>
              <div class="flex items-center gap-2 mb-2">
                <span class="font-mono text-[10px] uppercase tracking-widest text-mistral-textMuted">0{index + 1}</span>
                <span class="h-0.5 w-2 bg-mistral-text" aria-hidden="true" />
              </div>
              <p class="font-serif text-3xl tracking-tight text-mistral-text">{label}</p>
              <p class="mt-2 text-sm text-mistral-textMuted">{sub}</p>
            </div>
          );
        })}
      </div>
    </div>
  </ScrollContent>

  <!-- Featured Areas -->
  <ScrollContent class="pb-20 pt-14">
    <div
      data-scroll-reveal
      data-direction="up"
      data-distance="60"
      data-delay="0.1"
      class="mx-auto max-w-7xl px-5 sm:px-8"
    >
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {featuredAreas.map((area, index) => (
          <a
            key={area.href}
            href={area.href}
            data-od-id={`feature-card-${area.eyebrow}`}
            data-scroll-reveal
            data-direction="up"
            data-distance="30"
            data-delay={0.15 + index * 0.06}
            class="focus-ring group flex min-h-[220px] flex-col justify-between gap-10 rounded-xl border border-mistral-border bg-mistral-bgElevated p-8 transition-colors duration-300 hover:border-mistral-text hover:bg-white/5 sm:p-10"
          >
            <div class="flex items-start gap-3">
              <span class="font-mono text-[11px] uppercase tracking-widest text-mistral-textMuted">0{index + 1}</span>
              <p class="eyebrow">{area.eyebrow}</p>
            </div>
            <div>
              <h2 class="heading-3">{area.title}</h2>
              <p class="mt-3 body-md">{area.body}</p>
            </div>
            <span class="inline-flex items-center gap-2 text-sm font-medium text-mistral-text">
              open
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 19l7-7m0 0l-7-7m7 7H3" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </ScrollContent>

  <ScrollShowcase />

  <!-- Mentorship spotlight -->
  <ScrollContent class="pb-28">
    <div data-scroll-reveal data-direction="up" data-distance="60" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-[11px] uppercase tracking-widest text-mistral-textMuted">04</span>
        <span class="h-0.5 w-4 bg-mistral-text" aria-hidden="true" />
      </div>
      <a href="/experience" class="focus-ring group grid grid-cols-1 gap-8 rounded-xl border border-mistral-border bg-mistral-bgElevated p-8 transition-colors duration-300 hover:border-mistral-text hover:bg-white/5 sm:p-10 lg:grid-cols-[1fr_1.4fr] lg:items-center">
        <div>
          <p class="eyebrow">mentorship/</p>
          <h2 class="mt-4 heading-3">Coaching the next builders through FIRST LEGO League.</h2>
        </div>
        <div>
          <p class="body-md">I mentor a FIRST LEGO League team at Bicentennial Elementary School — guiding students through robot design, block coding, the innovation project, and competition-day problem solving.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-mistral-text">
            More in experience
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 19l7-7m0 0l-7-7m7 7H3" />
            </svg>
          </span>
        </div>
      </a>
    </div>
  </ScrollContent>

  <!-- CTA Section -->
  <ScrollContent class="pb-28">
    <div data-scroll-reveal data-direction="up" data-distance="60" data-delay="0.1" class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="font-mono text-[11px] uppercase tracking-widest text-mistral-textMuted">05</span>
        <span class="h-0.5 w-4 bg-mistral-text" aria-hidden="true" />
      </div>
      <div class="flex flex-wrap gap-4" data-stagger-container data-stagger="0.08" data-delay-children="0">
        {homeLinks.map((link, index) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            data-od-id={index === 0 ? 'cta-github' : link.label.toLowerCase()}
            class={`group focus-ring inline-flex h-12 items-center justify-center gap-2 rounded-full px-7 text-sm font-medium transition-colors duration-300 ${
              index === 0
                ? "bg-mistral-accent text-mistral-bg hover:bg-[#e5e5e5]"
                : "border border-mistral-text bg-transparent text-mistral-text hover:bg-white/5"
            }`}
          >
            {link.label}
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 19l7-7m0 0l-7-7m7 7H3" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </ScrollContent>

  <!-- About Preview Section -->
  <ScrollContent class="pb-28">
    <div data-scroll-reveal data-direction="up" data-distance="60" data-delay="0.15" class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-5 sm:px-8 md:grid-cols-[0.4fr_1fr]">
      <div class="text-center md:text-left">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-mistral-textMuted">06</span>
          <span class="h-0.5 w-4 bg-mistral-text" aria-hidden="true" />
        </div>
        <p class="eyebrow">work_in_progress/</p>
        <h2 class="mt-4 heading-2">Selected projects, competitions, and technical interests.</h2>
      </div>
      <p class="max-w-3xl body-lg self-center">
        The pages in the top navigation unpack the projects, competition history, and technical interests behind it. Scroll to explore each dimension.
      </p>
    </div>
  </ScrollContent>

  <!-- Scroll Indicator -->
  <div id="scroll-indicator" class="fixed bottom-10 left-1/2 z-20 -translate-x-1/2 pointer-events-none" style="animation: fadeIn 500ms ease-out 1.5s both;">
    <div class="flex flex-col items-center gap-2 text-mistral-textMuted">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em]">scroll</p>
      <div class="h-6 w-1.5 rounded-full border border-mistral-text/40 overflow-hidden">
        <div class="h-full w-full bg-mistral-text" style="animation: scrollBar 1.5s ease-in-out infinite;"></div>
      </div>
    </div>
  </div>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes scrollBar {
      0% { transform: translateY(-100%); }
      45%, 100% { transform: translateY(0); }
    }

    #scroll-indicator {
      transition: opacity 500ms ease, visibility 500ms ease;
    }

    #scroll-indicator.indicator-hidden {
      opacity: 0 !important;
      visibility: hidden;
    }
  </style>

  <script>
    const scrollIndicator = document.getElementById('scroll-indicator');
    if (scrollIndicator) {
      const hideIndicator = () => {
        scrollIndicator.classList.add('indicator-hidden');
        window.removeEventListener('scroll', hideIndicator);
      };
      window.addEventListener('scroll', hideIndicator, { passive: true });
    }
  </script>
</PageShell>