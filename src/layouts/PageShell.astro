---
// PageShell.astro - Main layout wrapper
// Provides navbar, footer, cursor field, scroll animations, and light Mistral theme

import NavBar from '@/components/NavBar.astro';
import Footer from '@/components/Footer.astro';
import CursorField from '@/components/CursorField.astro';
import IntroGate from '@/components/IntroGate.astro';

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = 'Yuvaan Gulati — Student Developer',
  description = 'Student developer building AI tools, robotics systems, and STEM learning projects.',
  class: className = '',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbfbf8" />
    <meta name="author" content="Yuvaan Gulati" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og.svg', Astro.site)} />
    <meta property="og:image:alt" content="Yuvaan Gulati — AI, Math, Robotics" />
    <meta property="og:site_name" content="Yuvaan Gulati" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.svg', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Yuvaan Gulati',
      url: 'https://iamyuvaangulati.vercel.app/',
      jobTitle: 'Student Developer',
      address: { '@type': 'PostalAddress', addressLocality: 'Greater Boston' },
      sameAs: ['https://github.com/yuvaang13', 'https://www.linkedin.com/in/yuvaan-gulati/'],
      knowsAbout: ['Artificial Intelligence', 'Robotics', 'Applied Mathematics', 'STEM Education', 'FIRST LEGO League mentoring'],
    })} />
  </head>
  <body class={`min-h-screen bg-mistral-bg text-mistral-text overflow-x-hidden ${className}`}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <!-- Cinematic Intro Gate — per-route (Yuvaan Gulati split-shutter) -->
    <IntroGate />

    <!-- Navigation -->
    <NavBar />

    <!-- Cursor field (global, draws neural web + glyphs on mouse move) -->
    <CursorField />

    <!-- Main Content -->
    <main id="main-content" class="relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Back to top -->
    <button id="back-to-top" class="back-to-top" aria-label="Back to top" type="button">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <!-- Scroll Progress Indicator -->
    <div id="scroll-progress-indicator" aria-hidden="true"></div>

    <!-- Initialize animations -->
    <script>
      import Lenis from 'lenis';
      import { initScrollAnimations } from '@/utils/scrollAnimations';

      // Slow, weighty inertial scroll (Mistral-style), skipped for reduced motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          lerp: 0.08,
          wheelMultiplier: 0.9,
          smoothWheel: true,
        });

        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      // Scroll-driven intro: reveals start immediately, intro gate opens with scroll
      initScrollAnimations();

      // Scroll progress indicator
      const progressBar = document.getElementById('scroll-progress-indicator');
      if (progressBar) {
        let ticking = false;
        const updateProgress = () => {
          const scrollY = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = Math.max(0, Math.min(1, scrollY / docHeight));
          progressBar.style.transform = `scaleX(${progress})`;
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }, { passive: true });

        // Initial update
        updateProgress();
      }

      // Back to top
      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        const toggleBackToTop = () => {
          backToTop.classList.toggle('is-visible', window.scrollY > 600);
        };
        window.addEventListener('scroll', toggleBackToTop, { passive: true });
        toggleBackToTop();
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import '@/styles/global.css';
</style>