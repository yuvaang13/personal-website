---
// PageShell.astro — paper, ink, and a quiet fixed header.

import NavBar from '@/components/NavBar.astro';
import Footer from '@/components/Footer.astro';
import { profile } from '@/data/profile';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = 'Yuvaan Gulati — Student Developer',
  description = 'Student developer building AI tools, robotics systems, and STEM learning projects.',
  class: className = '',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4efe3" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content="Yuvaan Gulati" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Yuvaan Gulati — AI, Math, Robotics" />
    <meta property="og:site_name" content="Yuvaan Gulati" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Yuvaan Gulati',
      url: 'https://iamyuvaangulati.vercel.app/',
      jobTitle: 'Student Developer',
      address: { '@type': 'PostalAddress', addressLocality: 'Greater Boston' },
      sameAs: ['https://github.com/yuvaang13', 'https://www.linkedin.com/in/yuvaan-gulati/'],
      knowsAbout: ['Artificial Intelligence', 'Robotics', 'Applied Mathematics', 'STEM Education', 'FIRST LEGO League mentoring'],
    })} />
  </head>
  <body class={className}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

    <NavBar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <button id="back-to-top" class="back-to-top" aria-label="Back to top" type="button">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>

    <script>
      const progress = document.getElementById('scroll-progress');
      const backToTop = document.getElementById('back-to-top');

      const updateChrome = () => {
        const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = docHeight > 0 ? Math.max(0, Math.min(1, scrollY / docHeight)) : 0;
        if (progress) progress.style.transform = `scaleX(${ratio})`;
        backToTop?.classList.toggle('is-visible', scrollY > 600);
      };

      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateChrome();
            ticking = false;
          });
        },
        { passive: true }
      );

      updateChrome();

      backToTop?.addEventListener('click', () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
      });
    </script>
  </body>
</html>
