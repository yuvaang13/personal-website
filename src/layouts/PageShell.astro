---
// PageShell.astro - Main layout wrapper
// Provides navbar, footer, cursor field, scroll animations, and light Mistral theme

import NavBar from '@/components/NavBar.astro';
import Footer from '@/components/Footer.astro';
import CursorField from '@/components/CursorField.astro';

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = 'Yuvaan Gulati — Student Developer',
  description = 'Student developer building AI tools, robotics systems, and STEM learning projects.',
  class: className = '',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class={`min-h-screen bg-mistral-bg text-mistral-text overflow-x-hidden ${className}`}>
    <!-- Navigation -->
    <NavBar />

    <!-- Cursor field (global, draws neural web + glyphs on mouse move) -->
    <CursorField />

    <!-- Main Content -->
    <main class="relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Scroll Progress Indicator -->
    <div id="scroll-progress-indicator" aria-hidden="true"></div>

    <!-- Initialize animations -->
    <script>
      import Lenis from 'lenis';
      import { initScrollAnimations } from '@/utils/scrollAnimations';

      // Slow, weighty inertial scroll (Mistral-style), skipped for reduced motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          lerp: 0.08,
          wheelMultiplier: 0.9,
          smoothWheel: true,
        });

        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      // Initialize scroll animations — gated by intro completion on home page
      const startReveals = () => initScrollAnimations();
      const gate = document.getElementById('intro-gate');

      if (gate && !document.documentElement.classList.contains('intro-skip')) {
        // Intro is present and will play — wait for it to finish
        let started = false;
        const begin = () => {
          if (!started) {
            started = true;
            startReveals();
          }
        };
        window.addEventListener('intro:done', begin, { once: true });
        // Failsafe: if intro never fires, start after 8s
        setTimeout(begin, 8000);
      } else {
        // No intro gate, or intro already skipped — start immediately
        startReveals();
      }

      // Scroll progress indicator
      const progressBar = document.getElementById('scroll-progress-indicator');
      if (progressBar) {
        let ticking = false;
        const updateProgress = () => {
          const scrollY = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = Math.max(0, Math.min(1, scrollY / docHeight));
          progressBar.style.transform = `scaleX(${progress})`;
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }, { passive: true });

        // Initial update
        updateProgress();
      }
    </script>
  </body>
</html>

<style is:global>
  @import '@/styles/global.css';
</style>